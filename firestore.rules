rules_version = '2';

// ============================================================
// ARVDOUL FIRESTORE SECURITY RULES — PRODUCTION v2
// Deny-by-default. Every collection the client services write
// is covered with ownership / participant / role checks that
// mirror the authorization the services already enforce.
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }
    function isOwner(userId) {
      return isSignedIn() && uid() == userId;
    }
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(uid()));
    }
    function isMember(userId, participantIds) {
      return isSignedIn() && userId in (participantIds || []);
    }
    // Supergroups rotate messages into monthly collections
    // (`conversations/{id}/messages_YYYY_MM`) once they pass the participant
    // threshold (MESSAGING_CONFIG.SUPERGROUP in src/services/messagesService.js).
    // Firestore rules cannot match a wildcard mid-path (`messages_{year}_{month}`
    // fails to compile), so the subcollection is matched as a single wildcard
    // and validated here. Before this, the whole ruleset failed to deploy.
    function isMessageShardCollection(collection) {
      return collection == 'messages' ||
        collection.matches('messages_[0-9]{4}_[0-9]{2}');
    }
    // Fields only the server (Cloud Functions / Admin SDK) may ever change.
    // Mirrors SERVER_AUTHORITATIVE_FIELDS in src/config/profileContracts.js;
    // a parity test in profilePiiBoundary.test.js keeps the two lists in step.
    // Clients that attempt to write any of these are rejected outright.
    function touchesServerAuthoritativeFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'xp', 'experience', 'experienceToNextLevel',
        'level', 'levelBand',
        'activeDays', 'activeDaysCount', 'activeStreak', 'longestStreak',
        'lastActiveDate', 'lastActiveDay',
        'reputation', 'reputationScore', 'reputationTier',
        'influence', 'influenceScore', 'contribution', 'contributionScore',
        'titles', 'activeTitle',
        'achievements', 'creatorStatus', 'creatorTier', 'isCreator',
        'monetizationEligible', 'coins', 'coinBalance', 'earnings',
        'totalEarned', 'isVerified', 'accountStatus', 'roles', 'role',
        'policyStanding'
      ]);
    }

    // Immutable authorship on create
    function authoredBy(field) {
      return request.resource.data[field] == uid();
    }

    // ---------- direct-message privacy ----------
    // The recipient's allowDMs preference (users/{uid}.settings.privacy.allowDMs,
    // written by the Settings screen) governs who may open a 1:1 conversation
    // with them: 'everyone' | 'friends' (mutual follow) | 'none'. Messages are
    // written straight from the client, so this is the only real enforcement
    // point. Absent settings default to 'everyone' (current behaviour).
    function followEdgeExists(a, b) {
      return exists(/databases/$(database)/documents/follows/$(a + '_' + b));
    }
    function dmAllowedTo(senderUid, recipientUid) {
      let pref = get(/databases/$(database)/documents/users/$(recipientUid)).data
        .get('settings', {}).get('privacy', {}).get('allowDMs', 'everyone');
      return pref == 'everyone' ||
        (pref == 'friends' &&
          followEdgeExists(senderUid, recipientUid) &&
          followEdgeExists(recipientUid, senderUid));
    }
    // The recipient explicitly consenting (accepting a pending request) overrides
    // their own allowDMs preference — otherwise a 'none' user could never accept.
    function dmRequestFrom(senderUid, recipientUid) {
      return exists(/databases/$(database)/documents/message_requests/$(recipientUid + '_' + senderUid));
    }

    // A pending friend request from `fromUid` to `toUid`. Used to authorise the
    // mutual-follow edges that accepting a friend request creates: the accepter
    // writes an edge whose `followerId` is the requester, which the plain
    // self-follow rule would refuse (this is why friend acceptance was silently
    // denied and no request could ever be accepted).
    // exists() first: get() on an absent document returns null and reading
    // `.data.status` from it raises an evaluation error, which would deny the
    // whole (short-circuiting OR) expression rather than just this branch.
    function friendRequestFrom(fromUid, toUid) {
      let p = /databases/$(database)/documents/friend_requests/$(fromUid + '_' + toUid);
      return exists(p) && get(p).data.status == 'pending';
    }

    // The same consent path for a private account's follow request: approving it
    // writes the requester's edge (followerId = requester, followingId = owner).
    function followRequestFrom(fromUid, toUid) {
      let p = /databases/$(database)/documents/follow_requests/$(fromUid + '_' + toUid);
      return exists(p) && get(p).data.status == 'pending';
    }

    // ---------- private-account content gate ----------
    // A private account's posts are readable only by the author, an admin, or an
    // approved follower. Firestore rules cannot call get()/exists() while
    // evaluating a list query *unless the query constrains the field*, so the
    // author's privacy is denormalised onto each post as `authorIsPrivate`
    // (written on every create path and refreshed when the owner toggles privacy).
    //   - Public feeds filter with `where('authorIsPrivate', '==', false)`; the
    //     first branch proves the condition and short-circuits, so exists() is
    //     never evaluated and the query is allowed.
    //   - An author-scoped query (`where('authorId', '==', x)`) proves the exists()
    //     branch, so an approved follower can read a private author's content.
    //   - An unconstrained list query cannot prove either branch and is denied
    //     wholesale (rules are not filters). The field must always be present: a
    //     missing value evaluates false, so only the owner branch can still admit
    //     it — everyone else is denied (fail closed).
    function postReadableByViewer() {
      return resource.data.authorIsPrivate == false ||
        isAdmin() ||
        (isSignedIn() &&
          (uid() == resource.data.authorId ||
            followEdgeExists(uid(), resource.data.authorId)));
    }

    // Fields that must never appear on the world-readable `users/{uid}` doc.
    // They live in `users_private/{uid}` instead (owner/admin only). Mirrors
    // PRIVATE_PROFILE_FIELDS in src/config/profileContracts.js.
    function touchesPrivateProfileFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'email', 'phoneNumber', 'emailVerified', 'phoneVerified',
        'stripeCustomerId', 'stripeAccountId', 'stripeSubscriptionId'
      ]);
    }

    // ==================== USERS ====================
    match /users/{userId} {
      // Public projection only: PII and Stripe identifiers live in
      // users_private/{uid}. Field-level masking is impossible on a readable
      // document, so the boundary is enforced by keeping those fields out.
      allow read: if isSignedIn();
      allow create: if isOwner(userId) &&
        !request.resource.data.keys().hasAny([
          'email', 'phoneNumber', 'emailVerified', 'phoneVerified',
          'stripeCustomerId', 'stripeAccountId', 'stripeSubscriptionId'
        ]) &&
        // Economy/status fields are server-authoritative; on create they must be
        // exactly the new-account defaults (NEW_USER_DEFAULTS in
        // src/shared/levelConfig.cjs). Without this a client could mint itself
        // coins, XP, a level, verification or a privileged role at signup.
        request.resource.data.get('coins', null) == 100 &&
        request.resource.data.get('level', null) == 1 &&
        request.resource.data.get('experience', null) == 0 &&
        request.resource.data.get('experienceToNextLevel', null) == 100 &&
        request.resource.data.get('totalEarned', null) == 0 &&
        request.resource.data.get('reputation', null) == 0 &&
        request.resource.data.get('isVerified', null) == false &&
        request.resource.data.get('isCreator', null) == false &&
        request.resource.data.get('accountStatus', null) == 'active' &&
        !request.resource.data.keys().hasAny([
          'roles', 'role', 'policyStanding', 'creatorStatus', 'creatorTier',
          'titles', 'activeTitle', 'achievements', 'monetizationEligible',
          'levelBand', 'activeDays', 'activeDaysCount', 'activeStreak',
          'longestStreak', 'lastActiveDate', 'lastActiveDay', 'coinBalance',
          'earnings', 'reputationScore', 'reputationTier', 'influence',
          'influenceScore', 'contribution', 'contributionScore'
        ]);
      // Admins (admins/{uid} doc) may moderate via the applyUserAdminAction
      // callable; a direct admin write from the client is refused so every
      // privileged change leaves a server-side audit entry.
      // Owners may edit their own profile but never a server-authoritative
      // field (level, XP, coins, verification, status, roles, ...). Account
      // deletion goes through the deleteUserData callable.
      // Reference: allow update, delete: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) && !touchesServerAuthoritativeFields() && !touchesPrivateProfileFields();
      allow delete: if false;
    }

    // ==================== USERS PRIVATE (PII / payment ids) ====================
    // email, phone, verification flags and Stripe identifiers. Never publicly
    // readable. The owner may only write the contact/verification fields; the
    // Stripe identifiers are server-written (admin SDK bypasses rules) so a
    // client cannot forge a payment id that a webhook would then trust.
    match /users_private/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) &&
        request.resource.data.keys().hasOnly(
          ['uid', 'email', 'phoneNumber', 'emailVerified', 'phoneVerified', 'updatedAt']
        );
      allow update: if isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['email', 'phoneNumber', 'emailVerified', 'phoneVerified', 'updatedAt']
        );
      allow delete: if false;
    }

    // ==================== ACTIVE DAYS LEDGER ====================
    match /active_days/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
      match /days/{dayId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isAdmin();
      }
    }

    // ==================== ACHIEVEMENTS ====================
    match /achievements/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      match /items/{achievementId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }
    }

    // ==================== TITLES ====================
    match /titles/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      match /items/{titleId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }
    }

    // ==================== CREATOR PROFILES ====================
    match /creator_profiles/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && request.resource.data.tier == 'NONE';
      allow update: if isAdmin() || (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['tier', 'eligibilityStatus', 'monetizationEligible', 'policyStanding', 'approvedAt']));
      allow delete: if isAdmin();
    }

    // ==================== REPUTATION ====================
    match /reputation/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ==================== WALLETS ====================
    match /wallets/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }

    // usernames registry: created/updated via owner flows; public read for availability and profile lookups
    match /usernames/{username} {
      allow read: if true;
      // Only the owner may create/update/delete a username doc that belongs to them.
      allow create, update: if isSignedIn() && request.resource.data.userId == uid();
      allow delete: if isSignedIn() && resource.data.userId == uid();
    }
    // Immutable username history: readable so old share/QR links keep resolving,
    // writable only by the owner who held the previous username.
    match /previous_usernames/{username} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == uid();
      allow update, delete: if false;
    }
    match /user_settings/{userId} {
      allow read, update, delete: if isOwner(userId);
      allow create: if isOwner(userId);
    }
    match /user_daily_stats/{statId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.userId);
      allow write: if isSignedIn() && request.resource.data.userId == uid();
    }
    match /user_preferences/{userId} {
      allow read, write: if isOwner(userId);
    }
    // Saved videos (Watch Later): the subcollection doc id is the video id;
    // only the owner may read/write their own saved list.
    match /users/{userId}/saved_videos/{videoId} {
      allow read, create, update, delete: if isOwner(userId);
    }
    // Saved messages (spec §33): references to original messages — owner-only.
    match /users/{userId}/saved_messages/{messageId} {
      allow read, create, update, delete: if isOwner(userId);
    }
    // Liked posts, saved posts, and user personal subcollections
    match /users/{userId}/liked_posts/{postId} {
      allow read, create, update, delete: if isOwner(userId);
    }
    match /users/{userId}/saved_posts/{postId} {
      allow read, create, update, delete: if isOwner(userId);
    }
    match /users/{userId}/shared_posts/{postId} {
      allow read, create, update, delete: if isOwner(userId);
    }
    match /users/{userId}/{subcollection}/{docId} {
      allow read, write: if isOwner(userId);
    }
    // Message requests (spec §35): id = `${recipientId}_${senderId}`.
    // Create only by the sender; read by either party; respond (accept/
    // decline) only by the recipient. Nobody else can touch them.
    match /message_requests/{requestId} {
      allow read: if isSignedIn() &&
        (resource.data.senderId == uid() || resource.data.recipientId == uid());
      allow create: if isSignedIn() &&
        request.resource.data.senderId == uid() &&
        request.resource.data.status == 'pending';
      allow update, delete: if isSignedIn() && resource.data.recipientId == uid();
    }

    // ==================== POSTS ====================
    match /posts/{postId} {
      // Public content (authorIsPrivate != true) is readable by anyone; a private
      // author's content only by the author or an admin (see postReadableByViewer).
      allow read: if postReadableByViewer();
      // `authorIsPrivate` is denormalised but not client-controlled: on the write
      // path a get() is allowed, so the stored value must equal the author's real
      // users/{uid}.isPrivate. A client cannot publish a public post for a private
      // account (or vice versa) to bypass the read gate.
      allow create: if isSignedIn() && authoredBy('authorId') &&
        request.resource.data.authorIsPrivate ==
          get(/databases/$(database)/documents/users/$(uid())).data.get('isPrivate', false);
      // Two legitimate updates, nothing else:
      //  - the author editing their own post, minus the moderation fields. Those
      //    belong to the server (reportContent / adminModerateContent); without
      //    this an author could clear `moderationStatus` / `reportCount` on
      //    their own flagged content — "moderation fields changed by the owner".
      //  - any signed-in user touching ONLY the engagement fields. Reactions,
      //    gifts and poll votes live on the post doc, so an author-only rule
      //    silently denied every non-author reaction/gift/vote.
      allow update: if isAdmin() || (isSignedIn() && (
        (request.auth.uid == resource.data.authorId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'moderationStatus', 'moderatedBy', 'moderatedAt', 'moderationScore', 'reportCount'
          ])) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'stats', 'gifts', 'poll', 'updatedAt'
        ])
      ));
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.authorId);
      // post subcollections (likes, saves, gifts, reactions): the doc id encodes
      // the acting user (e.g. likes/{userId}, gifts/{userId}_<ts>) — enforce it.
      match /{subcollection}/{docId} {
        allow read: if true;
        allow write: if isSignedIn() &&
          (docId == uid() || docId.startsWith(uid() + '_'));
      }
    }

    // ==================== COMMENTS ====================
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn() && authoredBy('userId');
      // Two legitimate updates, nothing else:
      //  - the author editing their own comment, minus the moderation verdict
      //    (moderation is server-only: the moderateComment onCreate trigger and
      //    adminModerateContent). The client scan that used to write those
      //    fields is gone, so the rules and the write paths now agree.
      //  - any signed-in user updating ONLY the reaction fields. The reaction
      //    arrays live on the comment doc, so without this a like by anyone but
      //    the author was denied and `likeComment` aborted.
      allow update: if isAdmin() || (isSignedIn() && (
        (request.auth.uid == resource.data.userId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'moderationStatus', 'moderatedBy', 'moderatedAt', 'moderationScore',
            'moderationNotes', 'isHidden', 'hiddenAt', 'hiddenReason',
            'autoModeratedAt', 'reports'
          ])) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'likes', 'likesBy', 'dislikes', 'dislikesBy', 'reactionCounts', 'updatedAt', 'lastActivityAt'
        ])
      ));
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;
      match /likes/{likerId} {
        allow read: if true;
        allow write: if isSignedIn() && likerId == uid();
      }
      match /dislikes/{dislikerId} {
        allow read: if true;
        allow write: if isSignedIn() && dislikerId == uid();
      }
      // Per-user emoji reaction (mirrors the post reaction subcollection). The
      // aggregate `reactionCounts` map lives on the comment doc; without this
      // match a reaction write fell through to the deny-all catch-all.
      match /reactions/{reactorId} {
        allow read: if true;
        allow write: if isSignedIn() && reactorId == uid();
      }
      // Edit history is appended by the comment author only; the record must
      // name the editor, so it cannot be forged as another user's edit.
      match /history/{historyId} {
        allow read: if true;
        allow create: if isSignedIn() && request.resource.data.editedBy == uid();
        allow update, delete: if false;
      }
    }

    // ==================== SOCIAL GRAPH ====================
    match /follows/{followId} {
      allow read: if isSignedIn();
      // You can only create your own follow edge (follower must be you), UNLESS
      // you are accepting a pending friend/follow request addressed to you:
      // accepting creates the requester's edge (`followerId` = requester,
      // `followingId` = you), which the self-follow rule alone would refuse. A
      // private account's content is gated on `authorIsPrivate`, so this consent
      // path is the only way a non-follower ever gains access.
      allow create: if isSignedIn() &&
        request.resource.data.followerId != request.resource.data.followingId &&
        (request.resource.data.followerId == uid() ||
          (request.resource.data.followingId == uid() &&
            (friendRequestFrom(request.resource.data.followerId, uid()) ||
              followRequestFrom(request.resource.data.followerId, uid()))));
      allow delete: if isSignedIn() &&
        (resource.data.followerId == uid() || resource.data.followingId == uid());
    }
    // ==================== FOLLOW REQUESTS ====================
    // A follow request is how a non-follower asks a private account for content
    // access. Firestore rules cannot read the target's `isPrivate` on create
    // (get() on the write path is fine, but the account state lives on the target
    // user doc), so the request is always allowed to be created for any target;
    // the target approves it, and approval writes the real `follows` edge under
    // the friendRequestFrom()/owner path. Only the two parties may read or write.
    match /follow_requests/{requestId} {
      allow read: if isSignedIn() &&
        (resource.data.fromUserId == uid() || resource.data.toUserId == uid());
      allow create: if isSignedIn() &&
        request.resource.data.fromUserId == uid() &&
        request.resource.data.toUserId != uid() &&
        request.resource.data.status == 'pending';
      allow update, delete: if isSignedIn() &&
        (resource.data.fromUserId == uid() || resource.data.toUserId == uid());
    }
    match /blocks/{blockId} {
      // Only the two parties may read a block edge. A world-readable block
      // collection lets anyone enumerate who blocks whom (a privacy leak);
      // every client read of this collection is already party-scoped.
      //
      // This rule (and the mute/restrict rules below) is `resource.data`-based,
      // so a `get` of a *missing* edge (`resource == null`) evaluates to a
      // permission error. Clients must therefore never answer "are we blocked?"
      // with a point read — they read the actor-scoped list query instead
      // (`socialGraphService._actorScopedIds`), which returns zero rows for an
      // absent edge and cannot be denied. Allowing `get` on a null `resource`
      // would instead leak edge existence for arbitrary pairs.
      allow read: if isSignedIn() &&
        (resource.data.blockerId == uid() || resource.data.blockedId == uid());
      // On create `resource` is null, so the blocker must be asserted from the
      // incoming payload; on delete it must match the stored owner.
      allow create: if isSignedIn() && request.resource.data.blockerId == uid();
      allow delete: if isSignedIn() && resource.data.blockerId == uid();
    }
    match /mutes/{muteId} {
      // A mute is private to the muter; the muted user must not be able to read it.
      allow read: if isSignedIn() && resource.data.muterId == uid();
      allow create: if isSignedIn() && request.resource.data.muterId == uid();
      allow delete: if isSignedIn() && resource.data.muterId == uid();
    }
    match /restricts/{restrictId} {
      // A restrict is private to the restricter.
      allow read: if isSignedIn() && resource.data.restricterId == uid();
      allow create: if isSignedIn() && request.resource.data.restricterId == uid();
      allow delete: if isSignedIn() && resource.data.restricterId == uid();
    }
    match /friend_requests/{requestId} {
      allow read: if isSignedIn() &&
        (resource.data.fromUserId == uid() || resource.data.toUserId == uid());
      allow create: if isSignedIn() && request.resource.data.fromUserId == uid();
      allow update, delete: if isSignedIn() &&
        (resource.data.fromUserId == uid() || resource.data.toUserId == uid());
    }

    // ==================== STORIES ====================
    // ==================== VIBES (ephemeral content) ====================
    // SERVER-ENFORCED lifecycle (spec §6/26/28/60):
    //  - read: signed-in + not deleted + moderation-approved-or-pending +
    //    NOT expired + visibility-gated + not blocked
    //  - write: authenticated creator only
    match /stories/{storyId} {
      // Fetched parent doc — usable from subcollection matches where
      // `resource` refers to the sub-document being written.
      function vibeData() {
        return get(/databases/$(database)/documents/stories/$(storyId)).data;
      }
      function vibeIsActive(s) {
        return s != null &&
          s.isDeleted == false &&
          s.status != 'expired' &&
          s.status != 'removed' &&
          s.moderationStatus != 'rejected' &&
          s.moderationStatus != 'removed' &&
          s.expiresAt > request.time;
      }
      function vibeVisibleToViewer(s, viewerId) {
        return s != null && (
          s.userId == viewerId ||
          s.visibility == 'public' ||
          (s.visibility == 'followers' &&
            exists(/databases/$(database)/documents/follows/$(viewerId + '_' + s.userId))) ||
          (s.visibility == 'private' && s.userId == viewerId)
        );
      }
      function vibeNotBlocked(s, viewerId) {
        return s != null &&
          !exists(/databases/$(database)/documents/blocks/$(viewerId + '_' + s.userId)) &&
          !exists(/databases/$(database)/documents/blocks/$(s.userId + '_' + viewerId));
      }
      allow read: if isSignedIn() &&
        vibeIsActive(resource.data) &&
        vibeVisibleToViewer(resource.data, uid()) &&
        vibeNotBlocked(resource.data, uid());
      allow create: if isSignedIn() && authoredBy('userId') &&
        request.resource.data.status == 'published' &&
        request.resource.data.moderationStatus == 'pending';
      // The owner may edit their own story (music, collaborators, tagged users,
      // visibility, lifecycle, share stats, soft-delete), but NOT the
      // moderation verdict. Without the exclusion the owner could clear
      // `moderationStatus` on their own rejected story and keep it visible.
      // `isDeleted` is allowed only as a one-way soft delete (false -> true) so
      // a removed story cannot be resurrected by its owner.
      allow update: if isSignedIn() && request.auth.uid == resource.data.userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'moderationStatus', 'moderationNotes', 'moderatedAt', 'moderatedBy',
          'moderationScore', 'reports', 'reportCount', 'userId', 'processingState'
        ]) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isDeleted']) ||
          request.resource.data.isDeleted == true);
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;
      match /viewers/{viewerId} {
        allow read: if isSignedIn() && (vibeData().userId == uid() || viewerId == uid());
        allow write: if isSignedIn() && viewerId == uid();
      }
      // Shards are BOUNDED AGGREGATION COUNTERS (spec §58): any signed-in
      // user may increment them; the pubsub aggregator owns the story-doc
      // stats. Clients cannot inflate the doc itself — only these counters.
      // Each shard is restricted to its known counter keys (+ updatedAt) so a
      // client cannot write arbitrary data into the aggregation collections.
      match /view_shards/{shardId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() &&
          request.resource.data.keys().hasOnly(['count', 'updatedAt']) &&
          request.resource.data.count is number;
      }
      match /reaction_shards/{shardId} {
        allow read: if true;
        allow write: if isSignedIn() && request.resource.data.keys().hasOnly([
          '❤️', '🔥', '😂', '😢', '😮', '👍', 'updatedAt'
        ]);
      }
      match /analytics_shards/{shardId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && request.resource.data.keys().hasOnly([
          'forwardTaps', 'backTaps', 'completions', 'comments', 'replies', 'updatedAt'
        ]);
      }
      // Reactions: only when the creator enabled them, and only while the
      // Vibe is active and visible to the reactor (spec §22).
      match /reactions/{reactorId} {
        allow read: if true;
        allow write: if isSignedIn() && reactorId == uid() &&
          vibeData().allowReactions == true &&
          vibeIsActive(vibeData()) &&
          vibeVisibleToViewer(vibeData(), uid());
      }
      // Comments: gated by allowComments + active + visible (spec §21).
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn() && authoredBy('userId') &&
          vibeData().allowComments == true &&
          vibeIsActive(vibeData()) &&
          vibeVisibleToViewer(vibeData(), uid());
        allow update, delete: if isSignedIn() && resource.data.userId == uid();
      }
      // Interactive stickers (poll / quiz / countdown / emoji slider). The
      // creator materialises these when the Vibe is published; viewers may
      // only ever UPDATE an active, visible Vibe's sticker (their vote), never
      // create or delete one. Without these matches Firestore rules fell
      // through to the deny-all catch-all and every vote/answer failed.
      match /polls/{pollId} {
        allow read: if isSignedIn() && vibeIsActive(vibeData()) && vibeVisibleToViewer(vibeData(), uid());
        allow create, delete: if isSignedIn() && vibeData().userId == uid();
        allow update: if isSignedIn() && vibeIsActive(vibeData()) && vibeVisibleToViewer(vibeData(), uid());
      }
      match /quizzes/{quizId} {
        allow read: if isSignedIn() && vibeIsActive(vibeData()) && vibeVisibleToViewer(vibeData(), uid());
        allow create, delete: if isSignedIn() && vibeData().userId == uid();
        allow update: if isSignedIn() && vibeIsActive(vibeData()) && vibeVisibleToViewer(vibeData(), uid());
      }
      match /countdowns/{countdownId} {
        allow read: if isSignedIn() && vibeIsActive(vibeData()) && vibeVisibleToViewer(vibeData(), uid());
        allow create, delete: if isSignedIn() && vibeData().userId == uid();
        allow update: if isSignedIn() && vibeData().userId == uid();
      }
      match /emoji_sliders/{sliderId} {
        allow read: if isSignedIn() && vibeIsActive(vibeData()) && vibeVisibleToViewer(vibeData(), uid());
        allow create, delete: if isSignedIn() && vibeData().userId == uid();
        allow update: if isSignedIn() && vibeIsActive(vibeData()) && vibeVisibleToViewer(vibeData(), uid());
      }
    }
    match /archived_stories/{storyId} {
      // Archive is PRIVATE to the creator (spec §31) — never public.
      allow read, update, delete: if isSignedIn() && resource.data.userId == uid();
      allow create: if isSignedIn() && request.resource.data.userId == uid();
    }
    match /highlights/{highlightId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == uid();
      allow update, delete: if isSignedIn() && resource.data.userId == uid();
      // Highlight contents inherit the parent's visibility: readable by any
      // signed-in user (the parent highlight itself is public), writable only
      // by the highlight's owner.
      function highlightOwner() {
        return get(/databases/$(database)/documents/highlights/$(highlightId)).data.userId;
      }
      match /highlightStories/{storyId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && highlightOwner() == uid();
      }
    }

    // ==================== MESSAGING (participant-scoped) ====================
    match /conversations/{conversationId} {
      function convParticipants() {
        return get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
      }
      function isConvAdmin() {
        return isSignedIn() && uid() in
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.admins;
      }
      function isConvModerator() {
        return isConvAdmin() || uid() in
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.moderators;
      }
      allow read: if isSignedIn() && uid() in resource.data.participants;
      // Updates: participants may update their own state (lastRead, mutedBy,
      // archivedBy, pinnedBy...) but CANNOT mutate admins/roles/participants
      // unless they are an admin (prevents self-promotion / member tampering).
      allow update: if isSignedIn() && uid() in resource.data.participants && (
        isConvAdmin() ||
        (request.resource.data.admins == resource.data.admins &&
         request.resource.data.roles == resource.data.roles &&
         request.resource.data.participants == resource.data.participants &&
         request.resource.data.createdBy == resource.data.createdBy)
      );
      allow delete: if isSignedIn() && (uid() in resource.data.participants && isConvAdmin());
      // A 1:1 conversation may only be opened if the *other* participant's
      // allowDMs preference admits the caller. Groups/channels (>2) are
      // unaffected. This is the enforcement point for the allowDMs setting,
      // which was previously a dead control (writable in Settings, checked
      // nowhere) that let anyone open a DM with anyone.
      allow create: if isSignedIn() &&
        uid() in request.resource.data.participants &&
        (
          request.resource.data.participants.size() != 2 ||
          (request.resource.data.participants[0] == uid() &&
            (dmAllowedTo(uid(), request.resource.data.participants[1]) ||
             dmRequestFrom(request.resource.data.participants[1], uid()))) ||
          (request.resource.data.participants[1] == uid() &&
            (dmAllowedTo(uid(), request.resource.data.participants[0]) ||
             dmRequestFrom(request.resource.data.participants[0], uid())))
        );

      // MESSAGES — ownership enforced:
      //  - create: the message must be authored by the caller
      //  - update/delete: the message owner, or a conversation admin/moderator
      //    (moderation), or a global admin
      //  - receipts (readBy/deliveredTo): ANY participant may append their own
      //    id to receipt arrays — the update must touch ONLY those fields
      //    (spec §17/18: conversation-level read position is preferred; these
      //    arrays are the per-message fallback).
      // Supergroups rotate into monthly shard collections
      // (`messages_YYYY_MM`, 1000+ participants); the subcollection name is
      // validated so both layouts get identical ownership rules.
      match /{messageShardCollection}/{messageId} {
        allow read: if isSignedIn() && isMessageShardCollection(messageShardCollection) && uid() in convParticipants();
        allow create: if isSignedIn() &&
          isMessageShardCollection(messageShardCollection) &&
          uid() in convParticipants() &&
          request.resource.data.senderId == uid();
        allow update, delete: if isSignedIn() && isMessageShardCollection(messageShardCollection) && uid() in convParticipants() && (
          resource.data.senderId == uid() || isConvModerator() || isAdmin() ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy', 'deliveredTo'])
        );
        // Reactions are per-user docs — no message-doc rewrites (spec §26).
        match /reactions/{userId} {
          allow read: if isSignedIn() && uid() in convParticipants();
          allow write: if isSignedIn() && userId == uid() && uid() in convParticipants();
        }
      }
      match /group_invites/{inviteId} {
        allow read: if isSignedIn() && uid() in convParticipants();
        // Only admins may create/revoke invites (prevents invite spam).
        allow create, update, delete: if isSignedIn() && isConvAdmin();
      }
    }
    match /message_dedupe/{key} {
      // Opaque idempotency keys. The client writes its own record and reads it
      // back in `_checkDuplicate` to detect a duplicate send, so read must stay
      // open to the sender; the key is sha256(sender:conversation:type:content)
      // so it leaks nothing and cannot be forged for another user's message.
      allow read, write: if isSignedIn();
    }
    match /last_messages/{conversationId} {
      // The preview text is the conversation's own content: readable only by a
      // participant. (It was `isSignedIn()`, so any signed-in user could read
      // every private conversation's last message by id.)
      allow read: if isSignedIn() && uid() in
        get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
      // Only participants may write the last-message preview (prevents
      // spoofing what a conversation shows in the inbox).
      allow write: if isSignedIn() && uid() in
        get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
    }

    // ==================== UNREAD COUNTERS (owner-scoped shards) ====================
    // Doc id format: unread_{conversationId}_{userId} — the trailing uid is
    // enforced so nobody can read/write another user's counters.
    match /unread_counters/{counterId} {
      allow read, write: if isSignedIn() && counterId.endsWith('_' + uid());
      match /shards/{shardId} {
        allow read, write: if isSignedIn() && counterId.endsWith('_' + uid());
      }
    }
    match /user_unread_totals/{userId} {
      allow read, write: if isOwner(userId);
      match /shards/{shardId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ==================== NOTIFICATIONS ====================
    match /notifications/{notificationId} {
      // Notifications are created server-side (Cloud Functions); users read
      // and acknowledge their own. No client-side create = no spam vector.
      allow read, update: if isSignedIn() &&
        (resource.data.userId == uid() || resource.data.recipientId == uid());
      allow delete: if isSignedIn() && resource.data.recipientId == uid();
      allow create: if false;
    }
    match /notification_counters/{userId} {
      allow read, update: if isOwner(userId);
      allow create: if isOwner(userId);
    }
    match /push_tokens/{tokenId} {
      allow read, write, delete: if isSignedIn() && resource.data.userId == uid();
      allow create: if isSignedIn() && request.resource.data.userId == uid();
      // Device registrations live one level deeper and Firestore rules do NOT
      // cascade, so the parent grant above does not cover them. Without this
      // nested match every registerPushToken()/removePushToken() call failed
      // with permission-denied and push notifications silently stopped.
      match /devices/{deviceId} {
        allow read, write: if isOwner(tokenId);
      }
    }

    // ==================== COINS / MONETIZATION ====================
    match /coin_transactions/{txId} {
      // Written only by Cloud Functions (monetization/levelSystem). Clients may
      // read their own entries; any client write is rejected.
      allow read: if isSignedIn() && (
        resource.data.userId == uid() ||
        resource.data.fromUserId == uid() ||
        resource.data.toUserId == uid() ||
        isAdmin()
      );
      allow create, update, delete: if false;
    }
    match /transactions/{txId} {
      allow read: if isSignedIn() && resource.data.userId == uid();
      allow write: if false;
    }
    match /subscriptions/{userId} {
      allow read: if isOwner(userId);
      allow write: if false; // server-only
    }
    match /payout_settings/{userId} {
      allow read, create, update: if isOwner(userId);
    }
    match /withdrawal_requests/{requestId} {
      allow read, create: if isSignedIn() && request.resource.data.userId == uid();
      // The owner may only CANCEL their own pending request. Approval/paid/
      // rejected transitions are server-only (adminDecideWithdrawal), and the
      // amount/address are immutable once the request exists.
      allow update: if isSignedIn() && resource.data.userId == uid() &&
        resource.data.status == 'pending' &&
        request.resource.data.status in ['cancelled'] &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['amount', 'address', 'method', 'userId']);
      allow delete: if false;
    }
    match /gift_transactions/{txId} {
      allow read: if isSignedIn() && (resource.data.fromUserId == uid() || resource.data.toUserId == uid());
      allow write: if false; // server-verified
    }
    match /ads/{adId} {
      allow read: if isSignedIn();
      allow write: if false; // admin via console/CF
    }
    match /ad_impressions/{impressionId} {
      allow read: if isSignedIn() && resource.data.userId == uid();
      allow write: if false;
    }
    match /idempotency_ledger/{key} {
      allow read, write: if false; // server-only
    }
    // Double-entry ledger written by functions/monetization.js
    // `createLedgerEntry` (debit + credit entries per coin movement). It is
    // server-write-only; a client-writable ledger is not an accounting record.
    match /ledger_entries/{entryId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
    // Per-user fraud velocity buckets and abuse flags, written by
    // functions/monetization.js (enforceDailyLimit / flagSuspiciousActivity).
    match /fraud_limits/{docId} {
      allow read, write: if false; // server-only
    }
    match /fraud_flags/{docId} {
      allow read: if isAdmin();
      allow write: if false; // server-only
    }
    match /counter_shards/{shardId} {
      // Hashed, non-PII shard keys. Only single-field value updates are
      // permitted (increments); full-document overwrites are blocked so
      // counters cannot be corrupted by clients.
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.keys().hasAll(['value']) && request.resource.data.keys().size() == 1;
      allow update: if isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['value']);
    }
    match /system/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ==================== LIVE ====================
    match /live_streams/{streamId} {
      allow read: if true;
      allow create: if isSignedIn() && authoredBy('userId');
      allow update, delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }
    match /live_viewers/{viewerId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.resource.data.userId == uid();
    }
    match /live_comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn() && authoredBy('userId');
      allow delete: if isSignedIn() && (resource.data.userId == uid() || isAdmin());
    }
    match /live_gifts/{giftId} {
      allow read: if isSignedIn();
      allow write: if false; // server-verified
    }

    // ==================== COMMUNITIES ====================
    match /communities/{communityId} {
      allow read: if true;
      allow create: if isSignedIn() && authoredBy('ownerId');
      allow update, delete: if (isSignedIn() && request.auth.uid == resource.data.ownerId) || isAdmin();
      match /{subcollection}/{docId} {
        allow read: if true;
        // Members may create their own content; only the author (or admin) may edit/delete.
        allow create: if isSignedIn() && (request.resource.data.authorId == uid() || request.resource.data.userId == uid());
        allow update, delete: if isSignedIn() && (resource.data.authorId == uid() || resource.data.userId == uid() || isAdmin());
      }
    }

    // ==================== EVENTS ====================
    match /events/{eventId} {
      allow read: if true;
      allow create: if isSignedIn() && authoredBy('organizerId');
      allow update, delete: if isSignedIn() && request.auth.uid == resource.data.organizerId;
      match /{subcollection}/{docId} {
        allow read: if true;
        allow create: if isSignedIn() && (request.resource.data.authorId == uid() || request.resource.data.userId == uid());
        allow update, delete: if isSignedIn() && (resource.data.authorId == uid() || resource.data.userId == uid() || isAdmin());
      }
    }

    // ==================== COLLABORATION ====================
    match /collaboration_projects/{projectId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && authoredBy('ownerId');
      allow update, delete: if isSignedIn() && request.auth.uid == resource.data.ownerId;
      match /{subcollection}/{docId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && (request.resource.data.authorId == uid() || request.resource.data.userId == uid());
        allow update, delete: if isSignedIn() && (resource.data.authorId == uid() || resource.data.userId == uid() || isAdmin());
      }
    }
    match /collaboration_invites/{inviteId} {
      // Invites carry the invitee's email address, so they are not a public
      // feed: only the inviter and the invited address may read them.
      allow read: if isSignedIn() && (
        resource.data.invitedBy == uid() ||
        (resource.data.email != null && resource.data.email == request.auth.token.email)
      );
      allow create: if isSignedIn() && request.resource.data.invitedBy == uid();
      allow update, delete: if isSignedIn() && (
        resource.data.invitedBy == uid() ||
        (resource.data.email != null && resource.data.email == request.auth.token.email) ||
        isAdmin()
      );
    }

    // ==================== COLLECTIONS (saved posts) ====================
    match /collections/{collectionId} {
      allow read, update, delete: if isSignedIn() && resource.data.userId == uid();
      allow create: if isSignedIn() && request.resource.data.userId == uid();
      match /items/{itemId} {
        // Items are bounded by the parent collection's ownership: only the
        // collection owner (or an admin) may add/remove entries. The previous
        // `if isSignedIn()` let any user write into anyone's collection.
        allow read: if isSignedIn();
        allow create: if isSignedIn() &&
          get(/databases/$(database)/documents/collections/$(collectionId)).data.userId == uid();
        allow update, delete: if isSignedIn() &&
          (get(/databases/$(database)/documents/collections/$(collectionId)).data.userId == uid() || isAdmin());
      }
    }

    // ==================== ANALYTICS ====================
    // Profile analytics (daily views/reach/engagement/coins) are private to the
    // profile owner and admins. A signed-in visitor must not be able to read a
    // creator's traffic, reach or earnings figures.
    match /profile_analytics/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // Views/reach are counted server-side by the trackProfileView callable,
      // which owns the daily dedupe and the sharded totals. A client write here
      // let any signed-in user inflate another creator's stats (audit N010).
      allow write: if false;
    }
    match /post_analytics/{postId} {
      allow read: if true;
      // Aggregate post analytics are server-computed (sharded counters); never client-written.
      allow write: if false;
    }
    // A profile view record is written by the trackProfileView callable and
    // read back only by the profile owner (who is the subject) or an admin.
    match /profile_views/{viewId} {
      allow read: if isSignedIn() && (resource.data.profileOwnerId == uid() || isAdmin());
      allow write: if false;
    }
    // Sharded counters: rules defined once, above, under idempotency_ledger.

    // ==================== MODERATION / ADMIN ====================
    // A reporter may read back only their own report; moderators read all.
    // (An unrestricted `read` here exposed every report body to any signed-in
    // user.) Report writes go through the reportContent callable, which stamps
    // reporterId server-side.
    match /comment_reports/{reportId} {
      allow read: if isSignedIn() && (resource.data.reporterId == uid() || isAdmin());
      allow create: if isSignedIn() && request.resource.data.reporterId == uid();
      // A reporter must not be able to resolve or rewrite their own report —
      // triage state is a moderator decision, not a client one.
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    match /user_reports/{reportId} {
      allow read: if isSignedIn() && (resource.data.reporterId == uid() || isAdmin());
      allow create: if isSignedIn() && request.resource.data.reporterId == uid();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    match /video_reports/{reportId} {
      allow read: if isSignedIn() && (resource.data.reportedBy == uid() || isAdmin());
      allow create: if isSignedIn() && request.resource.data.reportedBy == uid();
      allow update, delete: if isAdmin();
    }
    // Post/story reports are written by the reportContent callable (Admin SDK),
    // so clients only ever read their own or moderate as admin.
    match /post_reports/{reportId} {
      allow read: if isSignedIn() && (resource.data.reporterId == uid() || isAdmin());
      allow create: if isSignedIn() && request.resource.data.reporterId == uid();
      allow update, delete: if isAdmin();
    }
    match /story_reports/{reportId} {
      allow read: if isSignedIn() && (resource.data.reporterId == uid() || isAdmin());
      allow create: if isSignedIn() && request.resource.data.reporterId == uid();
      allow update, delete: if isAdmin();
    }
    // Ad reports are written by the reportAd callable (Admin SDK) and read by
    // the reporter or a moderator, matching the other report queues.
    match /ad_reports/{reportId} {
      allow read: if isSignedIn() && (resource.data.reporterId == uid() || isAdmin());
      allow create: if isSignedIn() && request.resource.data.reporterId == uid();
      allow update, delete: if isAdmin();
    }
    match /moderation_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // server-verified
    }
    match /admins/{userId} {
      // A client learns its own status through the getAdminStatus callable, so
      // the roster stays unreadable and cannot be enumerated.
      allow read: if false;
      allow write: if false; // server-only
    }

    // ==================== MISC (bounded write surfaces) ====================
    match /shares/{shareId} {
      allow read: if true;
      // A share record is immutable and must name the sharer as its author;
      // `if isSignedIn()` let anyone rewrite or delete another user's shares.
      allow create: if isSignedIn() && request.resource.data.userId == uid();
      allow update, delete: if isAdmin();
    }
    match /scheduled_messages/{messageId} {
      allow read, update, delete: if isSignedIn() && resource.data.userId == uid();
      allow create: if isSignedIn() && request.resource.data.userId == uid();
    }
    match /calls/{callId} {
      function callParticipants() {
        return get(/databases/$(database)/documents/calls/$(callId)).data.participants;
      }
      // Calls are private to participants (prevents reading others' call/SDP data).
      allow read, update, delete: if isSignedIn() && uid() in resource.data.participants;
      allow create: if isSignedIn() && uid() in request.resource.data.participants;
      match /ice/{candidateId} {
        allow read, write: if isSignedIn() && uid() in callParticipants();
      }
    }
    // WebRTC signaling for live streams and spaces. The room id equals the
    // stream/space id; participants are resolved from that parent document.
    // Kept separate from `calls` so the two flows cannot inherit each other's
    // access rules. Room documents carry SDP/ICE, so access is participants-only.
    match /signaling_rooms/{roomId} {
      function signalingParticipants() {
        // A signing-in member of the parent live stream or space may join.
        return isSignedIn() && (
          uid() in get(/databases/$(database)/documents/live_streams/$(roomId)).data.participants ||
          uid() in get(/databases/$(database)/documents/spaces/$(roomId)).data.participants
        );
      }
      // Membership is resolved from the parent stream/space, not from this
      // document: room docs only carry the offer/answer payload.
      allow read, create, update: if signalingParticipants();
      allow delete: if isAdmin();
      match /hostCandidates/{candidateId} {
        allow read, write: if signalingParticipants();
      }
      match /clientCandidates/{candidateId} {
        allow read, write: if signalingParticipants();
      }
    }
    match /rate_limits/{key} {
      allow read, write: if false; // server-only
    }
    match /fanout_tasks/{taskId} {
      allow read, write: if false; // server-only
    }

    // ==================== ADVANCED CREATOR SUITE (SPACES, SOUNDS, MARKETPLACE, POLLS, AI) ====================
    match /spaces/{spaceId} {
      allow read: if true;
      allow create: if isSignedIn() && (request.resource.data.host.id == uid() || request.resource.data.userId == uid());
      allow update, delete: if isSignedIn() && (resource.data.host.id == uid() || resource.data.userId == uid() || isAdmin());
      match /signals/{signalId} {
        allow read, write: if isSignedIn();
      }
    }
    match /sounds/{soundId} {
      allow read: if true;
      allow create: if isSignedIn() && (request.resource.data.creatorId == uid() || request.resource.data.authorId == uid());
      allow update, delete: if isSignedIn() && (resource.data.creatorId == uid() || resource.data.authorId == uid() || isAdmin());
    }
    match /marketplace_items/{itemId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.creatorId == uid();
      allow update, delete: if isSignedIn() && (resource.data.creatorId == uid() || isAdmin());
    }
    match /marketplace_orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.buyerId == uid() || resource.data.sellerId == uid() || isAdmin());
      allow create: if isSignedIn() && request.resource.data.buyerId == uid() &&
        request.resource.data.status in ['pending', 'created', 'awaiting_payment'];
      // Fulfilment state may move, but the financial fields are immutable once
      // written: neither party may rewrite the price, the buyer/seller, the
      // product or the download URL after the fact.
      allow update: if isAdmin() || (isSignedIn() &&
        (resource.data.buyerId == uid() || resource.data.sellerId == uid()) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'amountPaidCoins', 'priceCoins', 'priceUsd', 'buyerId', 'sellerId',
          'productId', 'product', 'amount', 'downloadUrl', 'purchasedAt', 'createdAt'
        ]));
      allow delete: if isAdmin();
    }
    match /polls/{pollId} {
      allow read: if true;
      allow create: if isSignedIn() && (request.resource.data.creatorId == uid() || request.resource.data.authorId == uid());
      allow update, delete: if isSignedIn() && (resource.data.creatorId == uid() || resource.data.authorId == uid() || isAdmin());
      match /votes/{voteId} {
        allow read: if true;
        allow write: if isSignedIn() && voteId == uid();
      }
    }
    match /prediction_markets/{marketId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.creatorId == uid();
      allow update, delete: if isSignedIn() && (resource.data.creatorId == uid() || isAdmin());
      match /bets/{betId} {
        allow read: if isSignedIn() && (resource.data.userId == uid() || isAdmin());
        allow create: if isSignedIn() && request.resource.data.userId == uid();
      }
    }
    match /ai_creations/{creationId} {
      allow read: if isSignedIn() && (resource.data.userId == uid() || resource.data.isPublic == true);
      allow create: if isSignedIn() && request.resource.data.userId == uid();
      allow update, delete: if isSignedIn() && (resource.data.userId == uid() || isAdmin());
    }
    match /badges/{badgeId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /user_badges/{userBadgeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ==================== LEVEL SYSTEM (XP + coin rewards + active day ledger) ====================
    match /coin_ledger/{entryId} {
      // Legacy level-up reward ledger. Level-up coins are now credited by the
      // server awardExperience function into `coin_transactions`, so this
      // collection is server-only: an unauthenticated create here would let a
      // client mint a "level_up_reward" entry.
      allow read: if isSignedIn() && resource.data.userId == uid();
      allow create, update, delete: if false;
    }

    match /active_days_ledger/{entryId} {
      // Server-authoritative daily active-day ledger, written only by the
      // recordActiveDay function. Doc id: `${userId}_${YYYY-MM-DD}`.
      allow read: if isSignedIn() && (resource.data.userId == uid() || isAdmin());
      allow create, update, delete: if false; // server-write-only
    }

    // ==================== SAVED SOUNDS ====================
    match /saved_sounds/{docId} {
      // Doc id encodes the owner: `${userId}_${soundId}`. Reads are owner-scoped
      // too — a saved-sounds list is private and must not be world-readable.
      allow read: if isSignedIn() && resource.data.userId == uid();
      allow create, delete: if isSignedIn() && docId.startsWith(uid() + '_');
      allow update: if false; // append-only (toggle = create/delete)
    }

    // ==================== DRAFTS ====================
    match /drafts/{draftId} {
      allow read, update, delete: if isSignedIn() && resource.data.userId == uid();
      allow create: if isSignedIn() && request.resource.data.userId == uid();
    }

    // ==================== VIDEOS ====================
    match /videos/{videoId} {
      allow read: if true;
      allow create: if isSignedIn() && (request.resource.data.userId == uid() || request.resource.data.authorId == uid());
      // The owner may edit their own video, but the moderation verdict and the
      // server-computed ranking/processing fields belong to the server
      // (moderateVideo / processVideoEvent). Without the exclusion the owner
      // could clear `moderationStatus` / `isDeleted` / `status` on their own
      // rejected video, or inflate `viralScore`/`rankingScore`.
      allow update: if isAdmin() || (isSignedIn() &&
        (resource.data.userId == uid() || resource.data.authorId == uid()) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'moderationStatus', 'moderationNotes', 'moderatedAt', 'moderatedBy',
          'moderationScore', 'reports', 'reportCount', 'status', 'isDeleted',
          'rankingScore', 'viralScore', 'audioFingerprint', 'muxAssetId',
          'muxPlaybackId', 'stats', 'userId'
        ]));
      allow delete: if isAdmin() || (isSignedIn() && (resource.data.userId == uid() || resource.data.authorId == uid()));
      match /stats/{statId} {
        allow read: if true;
        allow write: if false; // server-computed (sharded counters)
      }
      // Like docs: the doc id is the liker's uid. The likeVideo callable writes
      // them with the admin SDK (rules bypassed); a client may only read its own
      // so a detail screen can resolve "did I like this".
      match /likes/{likerId} {
        allow read: if isSignedIn() && request.auth.uid == likerId;
        allow write: if false; // server-owned (likeVideo)
      }
      match /like_shards/{shardId} {
        allow read: if true;
        allow write: if false; // server-computed
      }
    }

    // ==================== COPYRIGHT REGISTRY ====================
    match /copyright_registry/{workId} {
      // Rights holders register works from the client (registerWork) or via
      // admin import. Read is public (needed for detection); registrants may
      // remove their own works.
      allow read: if true;
      allow create: if isSignedIn() &&
        (request.resource.data.registeredBy == uid() || request.resource.data.userId == uid());
      allow update: if isAdmin();
      allow delete: if isSignedIn() &&
        (resource.data.registeredBy == uid() || resource.data.userId == uid() || isAdmin());
    }

    // ==================== ENTERPRISE SSO ====================
    match /enterprise_tenants/{tenantId} {
      // SAML tenant configuration - readable by signed-in users (SSO
      // initiation), writable only via admin/server.
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ==================== EVENTS (feedback) ====================
    match /event_feedback/{feedbackId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == uid();
      allow update, delete: if isSignedIn() && (resource.data.userId == uid() || isAdmin());
    }

    // ==================== GIFTS (client ledger for coin gifts) ====================
    match /gifts/{giftId} {
      allow read: if isSignedIn() && (resource.data.senderId == uid() || resource.data.recipientId == uid());
      allow create: if isSignedIn() && request.resource.data.senderId == uid();
      allow update, delete: if false; // append-only, server-verified
    }

    // ==================== INCIDENTS ====================
    match /incidents/{incidentId} {
      // An incident report carries a description and reporter identity; it is
      // private to the reporter (and admins). No client reads the whole queue.
      allow read: if isSignedIn() && (resource.data.reporterId == uid() || resource.data.userId == uid() || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.reporterId == uid() || request.resource.data.userId == uid());
      allow update, delete: if isSignedIn() && (resource.data.reporterId == uid() || resource.data.userId == uid() || isAdmin());
    }

    // ==================== LIVE TIPS ====================
    match /live_tips/{tipId} {
      allow read: if isSignedIn() && (resource.data.senderId == uid() || resource.data.recipientId == uid());
      allow create: if isSignedIn() && request.resource.data.senderId == uid();
      allow update, delete: if isAdmin();
    }

    // ==================== MESSAGE REPORTS ====================
    match /message_reports/{reportId} {
      allow read: if isSignedIn() && (resource.data.reporterId == uid() || isAdmin());
      allow create: if isSignedIn() && request.resource.data.reporterId == uid();
      allow update: if isSignedIn() && (resource.data.reporterId == uid() || isAdmin());
      allow delete: if isAdmin();
    }

    // ==================== MODERATION APPEALS ====================
    match /moderation_appeals/{appealId} {
      allow read: if isSignedIn() && (resource.data.userId == uid() || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == uid();
      allow update: if isSignedIn() && (resource.data.userId == uid() || isAdmin());
      allow delete: if isAdmin();
    }

    // ==================== POLL VOTES (flat) ====================
    match /poll_votes/{voteId} {
      // Vote ids encode the voter (`${userId}_${pollId}`). The `votePoll`
      // callable writes these with the Admin SDK and no client ever reads the
      // flat collection (vote history is kept locally in pollService), so this
      // is server-only — otherwise any signed-in user could enumerate voters.
      allow read, write: if false;
    }

    // ==================== STORY REPLIES ====================
    match /story_replies/{replyId} {
      allow read: if true;
      allow create: if isSignedIn() && (request.resource.data.userId == uid() || request.resource.data.authorId == uid());
      allow update, delete: if isSignedIn() && (resource.data.userId == uid() || resource.data.authorId == uid() || isAdmin());
    }

    // ==================== TRENDING (server-computed) ====================
    match /trending_topics/{topicId} {
      allow read: if isSignedIn();
      allow write: if false; // scheduled functions update
    }

    // ==================== USER EVENTS (append-only analytics) ====================
    match /user_events/{eventId} {
      allow read: if isSignedIn() && (resource.data.userId == uid() || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == uid();
      allow update, delete: if isAdmin();
    }

    // ==================== USER FEEDBACK ====================
    match /user_feedback/{feedbackId} {
      allow read: if isSignedIn() && (resource.data.userId == uid() || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == uid();
      allow update: if isSignedIn() && (resource.data.userId == uid() || isAdmin());
      allow delete: if isAdmin();
    }

    // ==================== VIEW EVENTS (append-only) ====================
    match /view_events/{eventId} {
      allow read: if isSignedIn() && (resource.data.userId == uid() || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == uid();
      allow update, delete: if false;
    }

    // ==================== MARKETPLACE ORDERS ====================
    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.buyerId == uid() || resource.data.sellerId == uid() || isAdmin());
      allow create: if isSignedIn() && request.resource.data.buyerId == uid() &&
        request.resource.data.status in ['pending', 'created', 'awaiting_payment'];
      // Same financial-field immutability as marketplace_orders.
      allow update: if isAdmin() || (isSignedIn() &&
        (resource.data.buyerId == uid() || resource.data.sellerId == uid()) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'amountPaidCoins', 'priceCoins', 'priceUsd', 'buyerId', 'sellerId',
          'productId', 'product', 'amount', 'downloadUrl', 'purchasedAt', 'createdAt'
        ]));
      allow delete: if isAdmin();
    }

    // ==================== MONETIZATION OUTBOX (offline queue mirror) ====================
    match /monetization_outbox/{outboxId} {
      allow read, update, delete: if isSignedIn() && resource.data.userId == uid();
      allow create: if isSignedIn() && request.resource.data.userId == uid();
    }

    // ==================== RANKINGS (server-computed) ====================
    match /rankings/{rankingId} {
      allow read: if isSignedIn();
      allow write: if false; // scheduled functions compute rankings
      match /{subcollection}/{docId} {
        allow read: if isSignedIn();
        allow write: if false;
      }
    }

    // ==================== TRENDING (server-computed) ====================
    match /trending/{trendId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ==================== MODERATION QUEUE ====================
    match /moderation_queue/{ticketId} {
      // Users create review tickets (reports) and can read their own ticket
      // status; status transitions are admin/server-only.
      allow read: if isSignedIn() && (resource.data.userId == uid() || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.userId == uid() || request.resource.data.reporterId == uid());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ==================== USER RECOMMENDATIONS (server-computed) ====================
    match /user_recommendations/{userId} {
      allow read: if isOwner(userId);
      allow write: if false; // generateFriendRecommendations function computes
      match /{subcollection}/{docId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    // ==================== CREATOR VERIFICATIONS ====================
    match /creator_verifications/{verificationId} {
      allow read: if isSignedIn() && (resource.data.userId == uid() || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == uid();
      allow update, delete: if isAdmin();
    }

    // ==================== PAYOUT REQUESTS ====================
    match /payout_requests/{requestId} {
      allow read: if isSignedIn() && (resource.data.userId == uid() || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == uid();
      allow update, delete: if isAdmin();
    }



    // ==================== SUPPORT TICKETS ====================
    match /support_tickets/{ticketId} {
      allow read: if isSignedIn() && (resource.data.userId == uid() || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == uid();
      allow update: if isAdmin() || (isSignedIn() && resource.data.userId == uid() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'userRating', 'updatedAt', 'messages']));
      allow delete: if isAdmin();
    }

    // ==================== AUDIT LOGS (immutable security trail) ====================
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      // Server-only: the Admin SDK writes audit entries. A client-writable audit
      // log is forgeable and therefore worthless as a trail.
      allow create: if false;
      allow update, delete: if false; // strictly immutable
    }

    // ==================== FEATURE FLAGS ====================
    match /feature_flags/{flagId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ==================== SYSTEM HEALTH / TELEMETRY ====================
    match /system_health/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ==================== ACCOUNT DELETIONS (owner-scoped) ====================
    match /account_deletions/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) && request.resource.data.userId == userId;
      allow delete: if isAdmin();
    }

    // ==================== SECURITY ALERTS (owner-scoped) ====================
    match /security_alerts/{alertId} {
      allow read: if isSignedIn() && (resource.data.userId == uid() || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == uid();
      allow update, delete: if isAdmin();
    }

    // ==================== CREATOR TAX PROFILES (owner-only, encrypted at rest) ====================
    match /creator_tax_profiles/{userId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && request.resource.data.userId == userId;
    }

    // ==================== FEED PERSONALIZATION (owner-only) ====================
    match /user_feed_preferences/{userId} {
      allow read, write: if isOwner(userId);
    }
    match /user_interest_vectors/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ==================== DAILY UPLOAD COUNTERS (owner-scoped shards) ====================
    match /daily_upload_counters/{shardId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create, update: if isOwner(request.resource.data.userId);
    }

    // ==================== ENGAGEMENT COIN EVENTS (server-authored, immutable) ====================
    match /coin_events/{eventId} {
      // Coin events are economic records: they must be authored by the server
      // (they are credited by awardExperience / the engagement pipeline), never
      // minted by a client. A client-writable coin event is a forged ledger row.
      allow read: if isSignedIn() && (resource.data.userId == uid() || isAdmin());
      allow create, update, delete: if false;
    }

    // ==================== VIDEO PURCHASES (entitlement record) ====================
    // Entitlements are written by the server; buyers may read their own.
    match /video_purchases/{purchaseId} {
      allow read: if isSignedIn() && (resource.data.userId == uid() || isAdmin());
      allow write: if false;
    }

    // ==================== APP CONFIG (server-managed, authenticated read) ====================
    match /config/{configId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ==================== DEFAULT DENY ====================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
