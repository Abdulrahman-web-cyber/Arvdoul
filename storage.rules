rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // User avatars — owner write, public read
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // User banners — owner write, public read
    match /banners/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Post media — owner write, public read
    match /posts/{userId}/{postId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Story media — owner write, public read (stories expire server-side)
    match /stories/{userId}/{storyId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Message media — participant read/write only (chat privacy)
    match /messages/{conversationId}/{messageId}/{fileName} {
      function isParticipant() {
        return request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
      }
      allow read: if isParticipant();
      allow write: if isParticipant();
    }

    // Live media — owner write, signed-in read
    match /live/{userId}/{streamId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Community media — owner write, signed-in read
    match /communities/{userId}/{communityId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Temp files (auto-delete after 24h) — owner-only
    match /temp/{userId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
