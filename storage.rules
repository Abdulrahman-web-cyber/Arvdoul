rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // ==================== MEDIA (owner write, per-namespace read) ====================
    // Every path the client writes is `{namespace}/{ownerUid}/...` so the write
    // gate can prove ownership from the path itself (`request.auth.uid ==
    // {userId}`). The previous layout (`avatars/{userId}/{fileName}`,
    // `posts/{userId}/{postId}/{fileName}`, ...) did NOT match what the client
    // actually wrote (`avatars/{uid}`, `posts/{uid}/{file}`,
    // `chat_media/{uid}/{file}`, `comments/voice/{uid}/{file}`, ...), so nearly
    // every upload was denied with `storage/unauthorized`. `{fileName=**}` is
    // used because it also matches the zero-segment form (`avatars/{uid}`).
    //
    // Sizes and content types are enforced on WRITE only. A delete carries no
    // `request.resource`, so evaluating `request.resource.size` on a delete
    // throws and the whole operation is denied — every owner delete (avatar
    // replacement, post media cleanup, temp expiry, story media removal) failed.
    // `allow delete` is therefore owner-only and separate from the write gate.

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // User avatars — owner write/delete, public read, image only, max 10 MB
    match /avatars/{userId}/{fileName=**} {
      allow read: if true;
      allow delete: if isOwner(userId);
      allow write: if isOwner(userId) &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // User banners — REMOVED. Arvdoul profiles do not use cover photos (product
    // policy), no client path uploads to `banners/`, and no surface reads it, so
    // the namespace was a dead, world-readable upload target. Do not re-add.

    // Post media — owner write/delete, public read, max 100 MB
    match /posts/{userId}/{fileName=**} {
      allow read: if true;
      allow delete: if isOwner(userId);
      allow write: if isOwner(userId) && request.resource.size <= 100 * 1024 * 1024;
    }

    // Story media (Vibes) — owner write/delete, visibility-scoped reads:
    //  - private/*: creator-only read
    //  - audience/{storyId}/*: creator OR viewer admitted by Firestore doc visibility/expiry/block gate
    //  - top-level/public: signed-in read
    match /stories/{userId}/private/{fileName=**} {
      allow read: if isOwner(userId);
      allow delete: if isOwner(userId);
      allow write: if isOwner(userId) &&
        request.resource.size < 100 * 1024 * 1024 &&
        (request.resource.contentType.matches('image/.*') ||
          request.resource.contentType.matches('video/.*') ||
          request.resource.contentType.matches('audio/.*'));
    }
    match /stories/{userId}/audience/{storyId}/{fileName=**} {
      function storyDoc() {
        return firestore.get(/databases/(default)/documents/stories/$(storyId)).data;
      }
      function canReadAudienceMedia() {
        return isOwner(userId) || (
          request.auth != null &&
          firestore.exists(/databases/(default)/documents/stories/$(storyId)) &&
          storyDoc().isDeleted == false &&
          storyDoc().status != 'expired' &&
          storyDoc().status != 'removed' &&
          storyDoc().expiresAt > request.time &&
          !firestore.exists(/databases/(default)/documents/blocks/$(request.auth.uid + '_' + userId)) &&
          !firestore.exists(/databases/(default)/documents/blocks/$(userId + '_' + request.auth.uid)) &&
          (
            storyDoc().visibility == 'public' ||
            (storyDoc().visibility == 'followers' &&
              firestore.exists(/databases/(default)/documents/follows/$(request.auth.uid + '_' + userId))) ||
            (storyDoc().visibility == 'connections' &&
              firestore.exists(/databases/(default)/documents/follows/$(request.auth.uid + '_' + userId)) &&
              firestore.exists(/databases/(default)/documents/follows/$(userId + '_' + request.auth.uid))) ||
            (storyDoc().visibility == 'close_circle' &&
              firestore.exists(/databases/(default)/documents/users/$(userId)/close_circle/$(request.auth.uid))) ||
            (storyDoc().visibility == 'selected' &&
              request.auth.uid in storyDoc().get('selectedUserIds', []))
          )
        );
      }
      allow read: if canReadAudienceMedia();
      allow delete: if isOwner(userId);
      allow write: if isOwner(userId) &&
        request.resource.size < 100 * 1024 * 1024 &&
        (request.resource.contentType.matches('image/.*') ||
          request.resource.contentType.matches('video/.*') ||
          request.resource.contentType.matches('audio/.*'));
    }
    // Legacy public stories uploaded before the story-id media path existed.
    // This exact one-segment match cannot overlap private/ or audience/ paths.
    match /stories/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow delete: if isOwner(userId);
      allow write: if isOwner(userId) &&
        request.resource.size < 100 * 1024 * 1024 &&
        (request.resource.contentType.matches('image/.*') ||
          request.resource.contentType.matches('video/.*') ||
          request.resource.contentType.matches('audio/.*'));
    }

    // Message media — participant read/write only (chat privacy), max 25 MB.
    // The path carries the conversationId so the rule can prove membership
    // against the conversation document (cross-service `firestore.get`).
    match /messages/{conversationId}/{fileName=**} {
      function isParticipant() {
        return request.auth != null &&
          request.auth.uid in
            firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.participants;
      }
      allow read: if isParticipant();
      allow delete: if isParticipant();
      allow write: if isParticipant() &&
        request.resource.size < 25 * 1024 * 1024 &&
        request.resource.contentType != null &&
        !request.resource.contentType.matches('text/html.*|image/svg.*|application/javascript.*|text/javascript.*|application/x-msdownload.*|application/x-executable.*|application/x-sh.*');
    }

    // Live media — REMOVED. Live streaming is signalling-only (no media is
    // uploaded; `live/` had no writer and no reader), so the namespace was a
    // dead, signed-in-readable upload target. Do not re-add without a real
    // streaming implementation.

    // Community media (avatar/cover) — owner write/delete, signed-in read
    match /communities/{userId}/{fileName=**} {
      allow read: if request.auth != null;
      allow delete: if isOwner(userId);
      allow write: if isOwner(userId) && request.resource.size < 100 * 1024 * 1024;
    }

    // Custom sounds (uploadCustomSound) — owner write/delete, public read,
    // audio content only, max 25 MB (matches the client-side limit).
    match /sounds/{userId}/{fileName=**} {
      allow read: if true;
      allow delete: if isOwner(userId);
      allow write: if isOwner(userId) &&
        request.resource.size < 25 * 1024 * 1024 &&
        request.resource.contentType.matches('audio/.*');
    }

    // Video uploads (videoService / Sparks) — owner write/delete, public read, max 100 MB
    match /videos/{userId}/{fileName=**} {
      allow read: if true;
      allow delete: if isOwner(userId);
      allow write: if isOwner(userId) && request.resource.size <= 100 * 1024 * 1024;
    }

    // Video thumbnails / exports — owner write/delete, public read
    match /thumbnails/{userId}/{fileName=**} {
      allow read: if true;
      allow delete: if isOwner(userId);
      allow write: if isOwner(userId) && request.resource.size < 10 * 1024 * 1024;
    }

    // Comment media (voice notes) — owner write/delete, public read
    match /comments/{userId}/{fileName=**} {
      allow read: if true;
      allow delete: if isOwner(userId);
      allow write: if isOwner(userId) && request.resource.size < 25 * 1024 * 1024;
    }

    // Event media (cover images) — owner write/delete, public read
    match /events/{userId}/{fileName=**} {
      allow read: if true;
      allow delete: if isOwner(userId);
      allow write: if isOwner(userId) && request.resource.size < 100 * 1024 * 1024;
    }

    // Group conversation photos — owner write/delete, signed-in read
    match /group-photos/{userId}/{fileName=**} {
      allow read: if request.auth != null;
      allow delete: if isOwner(userId);
      allow write: if isOwner(userId) &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // Audio-editor exports — owner write/delete, owner-only read, max 100 MB
    match /audio_exports/{userId}/{fileName=**} {
      allow read: if isOwner(userId);
      allow delete: if isOwner(userId);
      allow write: if isOwner(userId) && request.resource.size < 100 * 1024 * 1024;
    }

    // Temp files (auto-delete after 24h) — owner-only, max 50 MB
    match /temp/{userId}/{fileName=**} {
      allow read: if isOwner(userId);
      allow delete: if isOwner(userId);
      allow write: if isOwner(userId) && request.resource.size < 50 * 1024 * 1024;
    }

    // Generic owner-scoped media (storageService.generateSecurePath) —
    // `users/{uid}/{yyyy}/{mm}/{dd}/{hash}/{fileName}` — owner-only.
    match /users/{userId}/{fileName=**} {
      allow read: if isOwner(userId);
      allow delete: if isOwner(userId);
      allow write: if isOwner(userId);
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
