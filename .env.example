# ---------------------------------------------------------------------------
# Server-side (Cloud Functions) configuration — set via `firebase functions:config:set`
# ---------------------------------------------------------------------------
# IAP receipt validation (verifyPurchase fails closed without these):
#   firebase functions:config:set appstore.key_id="..." appstore.issuer_id="..." appstore.bundle_id="..."
#   firebase functions:config:set play.service_account="..."
# Email delivery (sendEmailNotification reports 'unconfigured' without this):
#   firebase functions:config:set sendgrid.key="..." sendgrid.from="no-reply@arvdoul.com"
# AI gateway (client AI features fail loudly without it):
#   firebase functions:config:set openai.key="..."
# Watermark bucket used by functions/video.js:
#   firebase functions:config:set watermark.bucket="arvdoul-media"
