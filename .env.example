# Arvdoul client environment template.
#
# Copy to `.env.local` (git-ignored) for local development, or set these as the
# build environment in CI / the hosting provider. Only `VITE_*` values are
# inlined into the client bundle — never put a real secret here (a Firebase web
# apiKey is a public client identifier, not a secret; a Stripe *secret* key is).
#
# Every variable below is read by the app (see `src/**`, guarded by
# `envTemplateCoverage.test.js`). A variable that no code reads must not be
# listed — it advertises a feature that does not exist.

# ---- Cloud Functions (server-side, non-VITE) ----
# Comma-separated owner emails allowed to claim the first admin grant
# (see "Owner / admin bootstrap" in AGENTS.md).
OWNER_EMAILS=

# ---- Firebase web SDK (public identifiers; usually supplied by
#      firebase-applet-config.json, overridable here) ----
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_DATABASE_ID=
VITE_FIREBASE_DATABASE_URL=
# Web Push (FCM) public VAPID key. Without it push registration is skipped.
VITE_FIREBASE_VAPID_KEY=
# Firebase App Check reCAPTCHA site key. Without it App Check is not enforced.
VITE_FIREBASE_APPCHECK_SITE_KEY=

# ---- Build / observability ----
# Surfaced in the app version label and push payloads.
VITE_APP_VERSION=
# When set, `src/utils/Logger.js` batches warn+ entries to this endpoint.
# Unset => the transport is a no-op (nothing is fabricated).
VITE_LOG_ENDPOINT=

# ---- Payments (Stripe) ----
# Stripe *publishable* key. Without it the card flow reports "unavailable"
# rather than faking a success; coins are only ever minted server-side.
VITE_STRIPE_PUBLISHABLE_KEY=

# ---- Search / discovery ----
# Algolia (client search key is a scoped, public search-only key).
VITE_ALGOLIA_APP_ID=
VITE_ALGOLIA_SEARCH_KEY=
# Optional vector-search backend (opt-in; disabled unless VECTOR_SEARCH_ENABLED).
VITE_VECTOR_SEARCH_ENABLED=
VITE_VECTOR_API_KEY=
# Top-N window the client requests from the server analytics ranking.
VITE_ANALYTICS_RANKING_TOP_N=

# ---- Integrations ----
# GIF picker (Giphy). Unset => the picker shows an unavailable state.
VITE_GIPHY_API_KEY=
# Server-side AI gateway. AI requests are proxied through functions/ai.js; with
# no gateway the caller shows an honest error (no local fallback is produced).
VITE_AI_GATEWAY_URL=
# Base URL used to build shareable invite links.
VITE_INVITE_BASE_URL=
