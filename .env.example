# Optional integrations. Each must be provisioned before its feature activates;
# absent values fail closed with an honest "not configured" message.
# AI gateway endpoint (functions/ai.js) for AI Studio.
VITE_AI_GATEWAY_URL=
# Cloud Functions healthCheck / systemMetrics HTTPS endpoints for the admin
# System Health screen.
VITE_SYSTEM_METRICS_URL=
# SAML assertion verification endpoint (functions/saml.js).
VITE_SAML_VERIFY_URL=
# Base URL used to build invite/share links.
VITE_INVITE_BASE_URL=
# Algolia search credentials.
VITE_ALGOLIA_APP_ID=
VITE_ALGOLIA_SEARCH_KEY=
# FCM web push VAPID key.
VITE_FIREBASE_VAPID_KEY=
# Fallback avatar for users without a profile picture.
VITE_DEFAULT_PROFILE_PICTURE=
# Client-side encryption key for local-at-rest data.
VITE_ENCRYPTION_KEY=
# Content-localization music library key.
VITE_MUSIC_API_KEY=
# Initial coin balance granted to brand-new accounts.
VITE_INITIAL_COIN_BALANCE=

# Server-side (Cloud Functions) configuration. These are NOT exposed to the
# browser. Set them for the functions deployment, e.g.:
#   firebase functions:config:unset --help   (legacy)
#   firebase deploy --only functions  with functions/.env populated
#
# Comma-separated list of the platform owner email addresses allowed to claim
# the first admin grant via Admin access (/admin/access -> Claim ownership).
# The owner's email must also be verified in Firebase Auth.
OWNER_EMAILS=