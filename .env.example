# ARVDOUL ENVIRONMENT CONFIGURATION
# Copy to .env and fill in production values. All VITE_* are client-safe.

# ---------- Firebase (required) ----------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ---------- Payments (required for purchases/subscriptions) ----------
# Client publishable key (pk_...)
VITE_STRIPE_PUBLISHABLE_KEY=
# Server secret key (sk_...) — set via `firebase functions:config:set stripe.secret_key=...`

# ---------- GIFs (required for GIF picker) ----------
VITE_GIPHY_API_KEY=

# ---------- Analytics ----------
# Optional: override ranking top-N default (100)
VITE_ANALYTICS_RANKING_TOP_N=100

# ---------- Feature flags ----------
# Optional remote vector search (defaults to local lexical search)
VITE_VECTOR_SEARCH_ENABLED=false
VITE_VECTOR_API_KEY=
