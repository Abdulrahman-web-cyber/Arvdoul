.ie-sw-custom {background:conic-gradient(#ff3b5c,#ff9f0a,#ffd60a,#30d158,#0a84ff,#8b1ef3,#ff3b5c);overflow:hidden}
.ie-sw-custom input {position:absolute;inset:0;width:100%;height:100%;opacity:0;cursor:pointer}
.ie-field {
  display:block;width:100%;min-height:44px;padding:0 12px;border:1px solid var(--field-border);border-radius:12px;
  background:var(--field-bg);color:var(--text);box-shadow:var(--field-inset);font:inherit;font-size:16px;font-weight:600;outline:0;
  transition:border-color .2s,box-shadow .2s,background .2s;
}
.ie-field:hover {border-color:var(--field-border-hover)}
.ie-field:focus {border-color:var(--field-focus);background:var(--field-bg-focus);box-shadow:var(--field-inset),0 0 0 3px var(--field-ring)}
textarea.ie-field {padding:11px 12px;line-height:1.45;resize:none;min-height:78px}
.ie-fonts {display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
.ie-font {
  min-height:44px;padding:0 10px;overflow:hidden;border:1px solid var(--field-border);border-radius:12px;background:var(--field-bg);
  color:var(--text);font-size:15px;text-align:left;text-overflow:ellipsis;white-space:nowrap;cursor:pointer;transition:border-color .18s,background .18s;
}
.ie-font:hover {border-color:var(--field-border-hover)}
.ie-font[aria-pressed="true"] {background:var(--pop-selected);border-color:var(--field-focus)}
.ie-hist {display:block;width:100%;height:84px;border:1px solid var(--field-border);border-radius:12px;background:var(--field-bg-solid)}
.ie-fgrid {display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}
.ie-fitem {display:flex;flex-direction:column;gap:6px;padding:0;border:0;background:none;color:var(--text-2);font-size:11.5px;font-weight:700;cursor:pointer}
.ie-fitem canvas {display:block;width:100%;aspect-ratio:1;border-radius:13px;border:2px solid transparent;background:var(--field-bg-solid);transition:border-color .18s,transform .18s}
.ie-fitem:hover canvas {transform:translateY(-2px)}
.ie-fitem[aria-pressed="true"] {color:var(--text)}
.ie-fitem[aria-pressed="true"] canvas {border-color:var(--field-focus);box-shadow:0 0 0 3px var(--field-ring)}
.ie-emoji {display:grid;place-items:center;aspect-ratio:1;padding:0;border:1px solid transparent;border-radius:12px;background:var(--field-bg);font-size:25px;line-height:1;cursor:pointer;transition:transform .15s,border-color .15s}
.ie-emoji:hover {border-color:var(--field-border-hover);transform:scale(1.08)}
.ie-emoji:active {transform:scale(.92)}
.ie-thumb {display:block;width:100%;aspect-ratio:1;object-fit:cover;border-radius:12px;border:1px solid var(--field-border)}
.ie-photo {padding:0;border:0;background:none;cursor:pointer;transition:transform .15s}
.ie-photo:hover {transform:translateY(-2px)}
.ie-layer {
  display:flex;align-items:center;gap:9px;padding:7px 8px;border:1px solid transparent;border-radius:13px;cursor:pointer;
  transition:background .15s,border-color .15s;
}
.ie-layer:hover {background:var(--pop-active)}
.ie-layer[data-sel="true"] {background:var(--pop-selected);border-color:var(--field-focus)}
.ie-layer-ico {display:grid;place-items:center;flex:none;width:34px;height:34px;border-radius:10px;background:var(--field-bg);color:var(--text-2);border:1px solid var(--field-border)}
.ie-layer-name {flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:13px;font-weight:700}
.ie-layer-name small {display:block;color:var(--text-3);font-size:11px;font-weight:600}
.ie-layer[data-hidden="true"] .ie-layer-name {opacity:.5}
.ie-hrow {
  display:flex;align-items:center;gap:10px;width:100%;min-height:42px;padding:0 10px;border:1px solid transparent;border-radius:12px;
  background:transparent;color:var(--text-2);font-size:13px;font-weight:650;text-align:left;cursor:pointer;
}
.ie-hrow:hover {background:var(--pop-active);color:var(--text)}
.ie-hrow[data-cur="true"] {background:var(--pop-selected);border-color:var(--field-focus);color:var(--text)}
.ie-hrow[data-future="true"] {opacity:.5}
.ie-hrow i {flex:none;width:8px;height:8px;border-radius:50%;background:var(--field-border-hover)}
.ie-hrow[data-cur="true"] i {background:var(--field-focus);box-shadow:0 0 0 3px var(--field-ring)}
.ie-card-note {display:flex;gap:10px;align-items:flex-start;padding:12px 13px;border:1px solid var(--field-border);border-radius:13px;background:var(--field-bg);color:var(--text-2);font-size:12.5px;line-height:1.5}
.ie-card-note svg {flex:none;margin-top:1px;color:var(--accent-text)}

/* Dialogs */
.ie-overlay {
  position:fixed;inset:0;z-index:60;display:grid;place-items:center;padding:16px;background:rgba(2,5,20,.68);
  -webkit-backdrop-filter:blur(7px);backdrop-filter:blur(7px);
}
.ie-dialog {
  width:min(480px,100%);max-height:calc(100vh - 32px);max-height:calc(100dvh - 32px);overflow-y:auto;padding:22px;
  border:1px solid var(--card-border);border-radius:26px;background:var(--pop-bg);color:var(--text);box-shadow:var(--pop-shadow);
}
.ie-dialog h3 {display:flex;align-items:center;gap:10px;margin:0;font-size:19px;font-weight:800;letter-spacing:-.025em}
.ie-dialog p.ie-sub {margin:6px 0 0;color:var(--text-2);font-size:13.5px;line-height:1.55}
.ie-dialog-f {display:flex;gap:10px;margin-top:22px}
.ie-dialog-f>* {flex:1}
.ie-load {position:fixed;inset:0;z-index:50;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;padding:24px;text-align:center;background:var(--bg);color:var(--text-2);font-size:14px}
.ie-load h3 {margin:0;color:var(--text);font-size:18px;font-weight:800}
.ie-load p {margin:0;max-width:300px;line-height:1.55}

.ie-root button:focus-visible,.ie-root input:focus-visible,.ie-root textarea:focus-visible,.ie-root [tabindex]:focus-visible {outline:2px solid var(--focus-outline);outline-offset:2px}
.ie-root .ie-range:focus-visible {outline:none}
.ie-root .ie-range:focus-visible::-webkit-slider-thumb {box-shadow:0 0 0 4px var(--field-ring),0 2px 8px rgba(0,0,0,.4)}

@keyframes ie-spin {to{transform:rotate(360deg)}}

@media(max-width:560px) {
  .ie-hide-sm {display:none}
  .ie-top {gap:6px}
  .ie-btn {padding:0 14px}
  .ie-dialog {padding:18px;border-radius:22px}
}
@media(max-width:420px) {
  .ie-top-c .ie-ibtn[data-optional="true"] {display:none}
  .ie-fonts {grid-template-columns:minmax(0,1fr)}
}
@media(pointer:coarse) {
  .ie-crop-h {width:44px;height:44px;margin:-22px 0 0 -22px}
  .ie-ibtn {width:42px;height:42px}
  .ie-pill .ie-ibtn {width:38px;height:38px}
}
@media(max-height:520px) and (orientation:landscape) {
  .ie-sheet {max-height:60vh}
}
@media(forced-colors:active) {
  .ie-ibtn,.ie-chip,.ie-tile,.ie-field,.ie-dialog {border:1px solid CanvasText}
  .ie-tool[aria-pressed="true"],.ie-chip[aria-pressed="true"] {outline:2px solid Highlight}
}
@media(prefers-reduced-motion:reduce) {
  .ie-root *,.ie-root *::before,.ie-root *::after {animation:none!important;transition-duration:.01ms!important;scroll-behavior:auto!important}
}
