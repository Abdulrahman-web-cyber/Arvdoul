  // Place the rect so the opposite corner / edge-centre stays anchored.
  const place = (pw, ph) => {
    if (corner) return { x: handle.includes('w') ? r - pw : start.x, y: handle.includes('n') ? b - ph : start.y };
    if (horizontalEdge) return { x: handle === 'w' ? r - pw : start.x, y: start.y + start.h / 2 - ph / 2 };
    return { x: start.x + start.w / 2 - pw / 2, y: handle === 'n' ? b - ph : start.y };
  };
  let pos = place(w, h);

  // If it spilled outside the image, shrink uniformly around the anchor.
  if (pos.x < 0 || pos.y < 0 || pos.x + w > W || pos.y + h > H) {
    let s = 1;
    if (pos.x < 0) s = Math.min(s, (w + pos.x) / w);
    if (pos.y < 0) s = Math.min(s, (h + pos.y) / h);
    if (pos.x + w > W) s = Math.min(s, (W - pos.x) / w);
    if (pos.y + h > H) s = Math.min(s, (H - pos.y) / h);
    s = Math.max(s, MIN_CROP / Math.max(Math.min(w, h), 1));
    w *= s;
    h *= s;
    pos = place(w, h);
  }
  return { x: clamp(pos.x, 0, W - w), y: clamp(pos.y, 0, H - h), w, h };
}

/* ════════════════════════════════════════════════════════════════════════════
 * Document reducer — every user-visible change is one undoable step
 * ════════════════════════════════════════════════════════════════════════════ */

const INITIAL_DOC = {
  originalImage: null,
  imageDimensions: { width: 1, height: 1 },
  adjustments: { ...ADJ_DEFAULT },
  filter: 'none',
  filterIntensity: 1,
  objects: [],
  selectedId: null,
  history: { past: [], future: [], last: null },
};

const snapshotOf = (s) => ({
  objects: cloneData(s.objects),
  adjustments: { ...s.adjustments },
  filter: s.filter,
  filterIntensity: s.filterIntensity,
  imageDimensions: { ...s.imageDimensions },
  originalImage: s.originalImage,
});

const applySnapshot = (s, sn) => {
  const objects = cloneData(sn.objects);
  return {
    ...s,
    objects,
    adjustments: { ...sn.adjustments },
    filter: sn.filter,
    filterIntensity: sn.filterIntensity,
    imageDimensions: { ...sn.imageDimensions },
    originalImage: sn.originalImage,
    selectedId: objects.some((o) => o.id === s.selectedId) ? s.selectedId : null,
  };
};

/** Pushes the previous state to history. Repeated edits with the same `coalesce` key
 *  inside ~1.2s (slider drags, typing) merge into a single undo step. */
const commit = (state, next, action) => {
  const h = state.history;
  const key = action.coalesce || null;
  const at = action.at || 0;
  const merge = key && h.last && h.last.key === key && at - h.last.at < 1200 && h.past.length > 0;
  const past = merge ? h.past : [...h.past, { snap: snapshotOf(state), label: action.label || 'Edit' }].slice(-HISTORY_LIMIT);
  return { ...next, history: { past, future: [], last: key ? { key, at } : null } };
};

const stepUndo = (state) => {
  const { past, future } = state.history;
  if (!past.length) return state;
  const top = past[past.length - 1];
  const restored = applySnapshot(state, top.snap);
  return { ...restored, history: { past: past.slice(0, -1), future: [{ snap: snapshotOf(state), label: top.label }, ...future], last: null } };
};
const stepRedo = (state) => {
  const { past, future } = state.history;
  if (!future.length) return state;
  const [first, ...rest] = future;
  const restored = applySnapshot(state, first.snap);
  return { ...restored, history: { past: [...past, { snap: snapshotOf(state), label: first.label }], future: rest, last: null } };
};

const bakeLinePoints = (o) => {
  const th = ((o.rotation || 0) * Math.PI) / 180;
  const c = Math.cos(th);
  const s = Math.sin(th);
  const sx = o.scaleX ?? 1;
  const sy = o.scaleY ?? 1;
  const pts = [];
  const src = o.points || [];
  for (let i = 0; i < src.length; i += 2) {
    const px = src[i] * sx;
    const py = src[i + 1] * sy;
    pts.push((o.x || 0) + px * c - py * s, (o.y || 0) + px * s + py * c);
  }
  return pts;
};

function transformObjects(objects, op, W, H) {
  const map =
    op === 'rotateCW' ? (x, y) => [H - y, x]
      : op === 'rotateCCW' ? (x, y) => [y, W - x]
        : op === 'flipH' ? (x, y) => [W - x, y]
          : (x, y) => [x, H - y];
  return objects.map((o) => {
    if (o.isBackground) return o;
    if (o.type === 'drawing') {
      const pts = bakeLinePoints(o);
      const out = [];
      for (let i = 0; i < pts.length; i += 2) {
        const [nx, ny] = map(pts[i], pts[i + 1]);
        out.push(nx, ny);
      }
      const k = (Math.abs(o.scaleX ?? 1) + Math.abs(o.scaleY ?? 1)) / 2;
      return { ...o, points: out, x: 0, y: 0, rotation: 0, scaleX: 1, scaleY: 1, brushSize: (o.brushSize || 5) * k };
    }
    if (op === 'rotateCW' || op === 'rotateCCW') {
      const [nx, ny] = map(o.x || 0, o.y || 0);
      return { ...o, x: nx, y: ny, rotation: (o.rotation || 0) + (op === 'rotateCW' ? 90 : -90) };
    }
    const box = localBox(o);
    const th = ((o.rotation || 0) * Math.PI) / 180;
    let cx = o.x || 0;
    let cy = o.y || 0;
    if (!box.centered) {
      const c = Math.cos(th);
      const s = Math.sin(th);
      cx += (box.w / 2) * c - (box.h / 2) * s;
      cy += (box.w / 2) * s + (box.h / 2) * c;
    }
    const [ncx, ncy] = map(cx, cy);
    const nth = -th;
    let nx = ncx;
    let ny = ncy;
    if (!box.centered) {
      const c = Math.cos(nth);
      const s = Math.sin(nth);
      nx = ncx - ((box.w / 2) * c - (box.h / 2) * s);
      ny = ncy - ((box.w / 2) * s + (box.h / 2) * c);
    }
    return { ...o, x: nx, y: ny, rotation: -(o.rotation || 0) };
  });
}

function docReducer(state, action) {
  switch (action.type) {
    case 'INIT': {
      const { image, width, height } = action;
      return {
        ...INITIAL_DOC,
        originalImage: image,
        imageDimensions: { width, height },
        objects: [
          { id: 'bg-img', type: 'image', isBackground: true, name: 'Photo', visible: true, locked: true, x: 0, y: 0, width, height, rotation: 0, scaleX: 1, scaleY: 1, opacity: 1 },
        ],
        history: { past: [], future: [], last: null },
      };
    }
    case 'SELECT':
      return state.selectedId === action.id ? state : { ...state, selectedId: action.id };
    case 'ADD_OBJECT':
      return { ...commit(state, { ...state, objects: [...state.objects, action.object], selectedId: action.object.id }, action) };
    case 'UPDATE_OBJECT': {
      const target = state.objects.find((o) => o.id === action.id);
      if (!target || target.isBackground) return state;
      return commit(state, { ...state, objects: state.objects.map((o) => (o.id === action.id ? { ...o, ...action.patch } : o)) }, action);
    }
    case 'DELETE_OBJECT': {
      const target = state.objects.find((o) => o.id === action.id);
      if (!target || target.isBackground) return state;
      return commit(state, { ...state, objects: state.objects.filter((o) => o.id !== action.id), selectedId: state.selectedId === action.id ? null : state.selectedId }, action);
    }
    case 'DUPLICATE_OBJECT': {
      const idx = state.objects.findIndex((o) => o.id === action.id);
      const src = state.objects[idx];
      if (idx === -1 || src.isBackground) return state;
      const off = Math.max(state.imageDimensions.width, state.imageDimensions.height) * 0.02;
      const clone = { ...cloneData(src), id: uid(), name: `${src.name || src.type} copy`, x: (src.x || 0) + off, y: (src.y || 0) + off, locked: false };
      const objects = [...state.objects];
      objects.splice(idx + 1, 0, clone);
      return commit(state, { ...state, objects, selectedId: clone.id }, action);
    }
    case 'TOGGLE_VISIBILITY':
      return commit(state, { ...state, objects: state.objects.map((o) => (o.id === action.id ? { ...o, visible: o.visible === false } : o)) }, action);
    case 'TOGGLE_LOCK': {
      const target = state.objects.find((o) => o.id === action.id);
      if (!target || target.isBackground) return state;
      return commit(state, { ...state, objects: state.objects.map((o) => (o.id === action.id ? { ...o, locked: !o.locked } : o)) }, action);
    }
    case 'MOVE_LAYER': {
      const idx = state.objects.findIndex((o) => o.id === action.id);
      const to = idx + action.dir;
      if (idx < 1 || to < 1 || to >= state.objects.length) return state;
      const objects = [...state.objects];
      [objects[idx], objects[to]] = [objects[to], objects[idx]];
      return commit(state, { ...state, objects }, action);
    }
    case 'SET_ADJUSTMENT':
      return commit(state, { ...state, adjustments: { ...state.adjustments, [action.key]: action.value } }, action);
    case 'SET_ADJUSTMENTS':
      return commit(state, { ...state, adjustments: { ...state.adjustments, ...action.values } }, action);
    case 'RESET_ADJUSTMENTS':
      return commit(state, { ...state, adjustments: { ...ADJ_DEFAULT } }, action);
    case 'SET_FILTER':
      return commit(state, { ...state, filter: action.filter, filterIntensity: action.filter === 'none' ? 1 : state.filterIntensity }, action);
    case 'SET_FILTER_INTENSITY':
      return commit(state, { ...state, filterIntensity: action.value }, action);
    case 'CLEAR_DRAWINGS': {
      if (!state.objects.some((o) => o.type === 'drawing')) return state;
      const objects = state.objects.filter((o) => o.type !== 'drawing');
      return commit(state, { ...state, objects, selectedId: objects.some((o) => o.id === state.selectedId) ? state.selectedId : null }, action);
    }
    case 'APPLY_CROP': {
      const { rect, image } = action;
      const objects = state.objects.map((o) => (o.isBackground ? { ...o, width: rect.w, height: rect.h } : { ...o, x: (o.x || 0) - rect.x, y: (o.y || 0) - rect.y }));
      return commit(state, { ...state, originalImage: image, imageDimensions: { width: rect.w, height: rect.h }, objects }, action);
    }
    case 'TRANSFORM_DOC': {
      const { op, image, width, height } = action;
      const { width: W, height: H } = state.imageDimensions;
      const objects = transformObjects(state.objects, op, W, H).map((o) => (o.isBackground ? { ...o, width, height } : o));
      return commit(state, { ...state, originalImage: image, imageDimensions: { width, height }, objects }, action);
    }
    case 'UNDO':
      return stepUndo(state);
    case 'REDO':
      return stepRedo(state);
    case 'JUMP': {
      let s = state;
      const target = clamp(action.index, 0, state.history.past.length + state.history.future.length);
      let guard = 200;
      while (s.history.past.length > target && guard--) s = stepUndo(s);
      while (s.history.past.length < target && guard--) s = stepRedo(s);
      return s;
    }
    default:
      return state;
  }
}
