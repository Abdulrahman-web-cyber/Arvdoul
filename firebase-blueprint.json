{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with display metadata, metrics, bio, badges, and verification status.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "username": { "type": "string", "maxLength": 64 },
        "displayName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 256 },
        "avatar": { "type": "string", "maxLength": 500 },
        "bio": { "type": "string", "maxLength": 500 },
        "isVerified": { "type": "boolean" },
        "coins": { "type": "number" },
        "reputationScore": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "username"]
    },
    "Post": {
      "title": "Post",
      "description": "Canonical publication record across posts and Sparks (text, image, video/spark/reel, poll, event, audio, link).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "authorId": { "type": "string", "maxLength": 128 },
        "author": { "type": "object" },
        "content": { "type": "string", "maxLength": 5000 },
        "title": { "type": "string", "maxLength": 200 },
        "type": { "type": "string", "enum": ["text", "image", "video", "poll", "event", "audio", "link"] },
        "subType": { "type": "string", "enum": ["spark", "reel", "video", "live"] },
        "mediaAssetId": { "type": "string", "maxLength": 128 },
        "muxAssetId": { "type": "string", "maxLength": 128 },
        "muxPlaybackId": { "type": "string", "maxLength": 128 },
        "playbackPolicy": { "type": "string", "enum": ["signed", "public"] },
        "processingState": { "type": "string", "maxLength": 64 },
        "duration": { "type": "number" },
        "aspectRatio": { "type": "string", "maxLength": 32 },
        "thumbnailUrl": { "type": "string", "maxLength": 1000 },
        "mediaUrl": { "type": "string", "maxLength": 1000 },
        "likesCount": { "type": "number" },
        "commentsCount": { "type": "number" },
        "sharesCount": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "authorId", "type"]
    },
    "Space": {
      "title": "Space",
      "description": "Live audio space / voice room with stage participants and coin tipping.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 100 },
        "host": { "type": "object" },
        "isLive": { "type": "boolean" },
        "audienceCount": { "type": "number" },
        "tipsTotalCoins": { "type": "number" },
        "startedAt": { "type": "number" }
      },
      "required": ["id", "title", "isLive"]
    },
    "MarketplaceItem": {
      "title": "MarketplaceItem",
      "description": "Creator digital goods, LUT presets, project files, and sounds.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 2000 },
        "priceCoins": { "type": "number" },
        "creatorId": { "type": "string", "maxLength": 128 },
        "previewUrl": { "type": "string", "maxLength": 500 },
        "downloadUrl": { "type": "string", "maxLength": 500 },
        "salesCount": { "type": "number" }
      },
      "required": ["id", "title", "priceCoins", "creatorId"]
    },
    "Poll": {
      "title": "Poll",
      "description": "Community poll or prediction market with real-time stakes.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "question": { "type": "string", "maxLength": 300 },
        "creatorId": { "type": "string", "maxLength": 128 },
        "options": { "type": "object" },
        "totalVotes": { "type": "number" },
        "isPrediction": { "type": "boolean" },
        "totalStake": { "type": "number" }
      },
      "required": ["id", "question", "creatorId"]
    },
    "ActiveDayLedger": {
      "title": "ActiveDayLedger",
      "description": "Server-authoritative calendar day ledger record for a user's qualifying daily activities.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 10 },
        "qualifyingEvents": { "type": "array" },
        "firstQualifiedAt": { "type": "string" },
        "lastQualifiedAt": { "type": "string" },
        "status": { "type": "string", "enum": ["verified", "pending", "flagged"] },
        "calculationVersion": { "type": "number" }
      },
      "required": ["uid", "date", "status"]
    },
    "Achievement": {
      "title": "Achievement",
      "description": "Server-validated permanent record of accomplishment with criteria versioning.",
      "type": "object",
      "properties": {
        "achievementId": { "type": "string", "maxLength": 128 },
        "category": { "type": "string", "enum": ["Progression", "Creation", "Creator", "Community", "Exploration", "Economy", "Events", "Social", "Citizenship", "Historical"] },
        "criteriaVersion": { "type": "number" },
        "earnedAt": { "type": "string" },
        "source": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["earned", "revoked"] },
        "metadata": { "type": "object" }
      },
      "required": ["achievementId", "category", "earnedAt"]
    },
    "Title": {
      "title": "Title",
      "description": "Recognition layer granted via multidimensional criteria or civic contribution.",
      "type": "object",
      "properties": {
        "titleId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "category": { "type": "string", "enum": ["Creation", "Community", "Economic", "CivicRoyal", "Historical"] },
        "criteriaVersion": { "type": "number" },
        "grantedAt": { "type": "string" },
        "provenance": { "type": "string", "maxLength": 200 }
      },
      "required": ["titleId", "name", "category", "grantedAt"]
    },
    "CreatorProfile": {
      "title": "CreatorProfile",
      "description": "Creator capability class profile containing tier, eligibility, and monetization permissions.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "tier": { "type": "string", "enum": ["NONE", "CREATOR", "ADVANCED", "PROFESSIONAL", "ELITE", "PARTNER"] },
        "eligibilityStatus": { "type": "string", "enum": ["ineligible", "eligible", "approved", "suspended"] },
        "monetizationEligible": { "type": "boolean" },
        "policyStanding": { "type": "string", "enum": ["good", "warning", "restricted"] },
        "approvedAt": { "type": "string" }
      },
      "required": ["uid", "tier", "eligibilityStatus"]
    },
    "UserReputation": {
      "title": "UserReputation",
      "description": "Server-evaluated trust, reliability, moderation standing, and community behavior record.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "trust": { "type": "number" },
        "reliability": { "type": "number" },
        "contributions": { "type": "number" },
        "moderation": { "type": "number" },
        "totalScore": { "type": "number" },
        "tier": { "type": "string", "enum": ["Unestablished", "Developing", "Established", "Trusted", "Highly Trusted", "Exceptional"] },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "totalScore", "tier"]
    },
    "CreatorVerification": {
      "title": "CreatorVerification",
      "description": "Creator badge application with identity standing, follower count, and verification status.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "category": { "type": "string", "maxLength": 100 },
        "submittedAt": { "type": "string" },
        "reviewedAt": { "type": "string" },
        "reviewedBy": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "userId", "status"]
    },
    "PayoutRequest": {
      "title": "PayoutRequest",
      "description": "Creator withdrawal and disbursement request.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "coins": { "type": "number" },
        "amountUsd": { "type": "number" },
        "method": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "enum": ["pending", "completed", "rejected"] },
        "requestedAt": { "type": "string" }
      },
      "required": ["id", "userId", "coins", "amountUsd", "status"]
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "description": "User customer support inquiry and resolution thread.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "subject": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "enum": ["open", "in_progress", "resolved", "closed"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "subject", "status"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable administrative and financial security event trail.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "actor": { "type": "string", "maxLength": 128 },
        "action": { "type": "string", "maxLength": 100 },
        "category": { "type": "string", "maxLength": 64 },
        "severity": { "type": "string", "enum": ["info", "warning", "critical"] },
        "timestamp": { "type": "string" },
        "metadata": { "type": "object" }
      },
      "required": ["id", "action", "timestamp"]
    },
    "ProfileAnalytics": {
      "title": "ProfileAnalytics",
      "description": "User profile metrics, daily stats, and reach aggregations.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "totalViews": { "type": "number" },
        "totalReach": { "type": "number" },
        "totalEngagement": { "type": "number" },
        "coinsEarned": { "type": "number" },
        "dailyStats": { "type": "object" },
        "lastUpdated": { "type": "string" }
      },
      "required": ["totalEngagement"]
    },
    "CounterShard": {
      "title": "CounterShard",
      "description": "Distributed sharded counter document for high-throughput metrics.",
      "type": "object",
      "properties": {
        "count": { "type": "number" },
        "docPath": { "type": "string", "maxLength": 256 },
        "field": { "type": "string", "maxLength": 64 },
        "shardIndex": { "type": "number" }
      },
      "required": ["count", "docPath", "field", "shardIndex"]
    },
    "Story": {
      "title": "Story",
      "description": "Ephemeral 24-hour Vibe (image, video, text, or audio) with audience privacy, overlays, and edit metadata.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["image", "video", "text", "audio", "event"] },
        "content": { "type": "string", "maxLength": 500 },
        "visibility": { "type": "string", "enum": ["public", "followers", "connections", "close_circle", "selected", "private"] },
        "selectedUserIds": { "type": "array" },
        "textOverlays": { "type": "array" },
        "drawingPaths": { "type": "array" },
        "mediaEdits": { "type": "object" },
        "textStyle": { "type": "object" },
        "status": { "type": "string", "enum": ["published", "expired", "removed"] },
        "createdAt": { "type": "string" },
        "expiresAt": { "type": "string" }
      },
      "required": ["id", "userId", "type", "visibility", "status"]
    },
    "CloseCircleMember": {
      "title": "CloseCircleMember",
      "description": "Owner-curated Close Circle recipient entry scoped to users/{userId}/close_circle/{memberId}.",
      "type": "object",
      "properties": {
        "memberId": { "type": "string", "maxLength": 128 },
        "addedAt": { "type": "string" }
      },
      "required": ["memberId"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Participant-scoped 1:1 direct, group, or channel conversation thread.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["direct", "group", "channel"] },
        "participants": { "type": "array" },
        "participantCount": { "type": "number" },
        "createdBy": { "type": "string", "maxLength": 128 },
        "isActive": { "type": "boolean" },
        "lastRead": { "type": "object" },
        "lastDelivered": { "type": "object" },
        "mutedBy": { "type": "array" },
        "pinnedBy": { "type": "array" },
        "archivedBy": { "type": "array" },
        "pinnedMessages": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "lastActivity": { "type": "string" }
      },
      "required": ["id", "type", "participants", "createdBy", "isActive"]
    },
    "Message": {
      "title": "Message",
      "description": "Conversation message with media, link preview, shared content reference, reply/forward metadata, and soft-delete fields.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "conversationId": { "type": "string", "maxLength": 128 },
        "senderId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["text", "image", "video", "audio", "file", "voice", "gif", "sticker", "location", "contact", "poll", "reply", "forward", "system", "view_once", "link", "shared_content"] },
        "content": { "type": "string", "maxLength": 5000 },
        "encrypted": { "type": "boolean" },
        "media": { "type": "object" },
        "linkPreview": { "type": "object" },
        "sharedContent": { "type": "object" },
        "replyTo": { "type": "object" },
        "forwardFrom": { "type": "object" },
        "isEdited": { "type": "boolean" },
        "isDeleted": { "type": "boolean" },
        "deletedFor": { "type": "array" },
        "readBy": { "type": "array" },
        "deliveredTo": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "conversationId", "senderId", "type"]
    },
    "MessageReaction": {
      "title": "MessageReaction",
      "description": "Per-user emoji reaction owned by the reacting participant.",
      "type": "object",
      "properties": {
        "emoji": { "type": "string", "maxLength": 16 },
        "conversationId": { "type": "string", "maxLength": 128 },
        "messageId": { "type": "string", "maxLength": 128 },
        "at": { "type": "string" }
      },
      "required": ["emoji", "conversationId", "messageId"]
    },
    "MessageRequest": {
      "title": "MessageRequest",
      "description": "Direct-message permission request when recipient privacy restricts open DMs.",
      "type": "object",
      "properties": {
        "senderId": { "type": "string", "maxLength": 128 },
        "recipientId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["pending", "accepted", "declined"] },
        "createdAt": { "type": "string" }
      },
      "required": ["senderId", "recipientId", "status"]
    },
    "LastMessage": {
      "title": "LastMessage",
      "description": "Latest message preview document synced atomically for inbox rows.",
      "type": "object",
      "properties": {
        "messageId": { "type": "string", "maxLength": 128 },
        "senderId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "maxLength": 32 },
        "text": { "type": "string", "maxLength": 200 },
        "timestamp": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["messageId", "senderId", "type"]
    },
    "CommunityChannel": {
      "title": "CommunityChannel",
      "description": "Structured sub-channel inside a community (discussion, announcements, events).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "communityId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 64 },
        "slug": { "type": "string", "maxLength": 64 },
        "type": { "type": "string", "enum": ["discussion", "announcements", "events"] },
        "description": { "type": "string", "maxLength": 300 },
        "isDefault": { "type": "boolean" },
        "isLocked": { "type": "boolean" },
        "slowModeSeconds": { "type": "number" },
        "order": { "type": "number" },
        "messageCount": { "type": "number" },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "communityId", "name", "type"]
    },
    "ChannelMessage": {
      "title": "ChannelMessage",
      "description": "Message inside a structured community channel with role gating and moderation state.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "communityId": { "type": "string", "maxLength": 128 },
        "channelId": { "type": "string", "maxLength": 128 },
        "senderId": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 100 },
        "type": { "type": "string", "enum": ["text", "image", "event_share", "announcement", "system"] },
        "content": { "type": "string", "maxLength": 5000 },
        "isPinned": { "type": "boolean" },
        "isDeleted": { "type": "boolean" },
        "sharedContent": { "type": "object" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "communityId", "channelId", "senderId", "type"]
    },
    "CallSession": {
      "title": "CallSession",
      "description": "Server-validated voice or video call signaling and lifecycle record.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "conversationId": { "type": "string", "maxLength": 128 },
        "callerId": { "type": "string", "maxLength": 128 },
        "calleeIds": { "type": "array" },
        "participants": { "type": "array" },
        "callType": { "type": "string", "enum": ["audio", "video"] },
        "status": { "type": "string", "enum": ["initiated", "ringing", "accepted", "connecting", "connected", "reconnecting", "ended", "rejected", "missed", "cancelled", "failed", "timed_out"] },
        "durationSeconds": { "type": "number" },
        "initiatedAt": { "type": "string" },
        "endedAt": { "type": "string" }
      },
      "required": ["id", "callerId", "participants", "callType", "status"]
    },
    "UserDeviceSession": {
      "title": "UserDeviceSession",
      "description": "Active authenticated device session for multi-device sync and remote revocation.",
      "type": "object",
      "properties": {
        "deviceId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "label": { "type": "string", "maxLength": 120 },
        "platform": { "type": "string", "maxLength": 64 },
        "revoked": { "type": "boolean" },
        "lastSeenAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["deviceId", "userId"]
    },
    "ModerationReport": {
      "title": "ModerationReport",
      "description": "Abuse report submitted for a group, community, channel, or call.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "reporterId": { "type": "string", "maxLength": 128 },
        "targetId": { "type": "string", "maxLength": 128 },
        "targetType": { "type": "string", "enum": ["group", "community", "channel", "call"] },
        "reason": { "type": "string", "maxLength": 200 },
        "status": { "type": "string", "enum": ["pending", "resolved", "dismissed"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "reporterId", "targetId", "targetType", "reason", "status"]
    },
    "VideoMigrationMap": {
      "title": "VideoMigrationMap",
      "description": "Mapping from legacy videos/{legacyId} document to canonical posts/{canonicalPostId}.",
      "type": "object",
      "properties": {
        "legacyVideoId": { "type": "string", "maxLength": 128 },
        "canonicalPostId": { "type": "string", "maxLength": 128 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["migrated", "rolled_back"] },
        "migratedAt": { "type": "string" }
      },
      "required": ["legacyVideoId", "canonicalPostId", "ownerId", "status"]
    },
    "MuxWebhookEvent": {
      "title": "MuxWebhookEvent",
      "description": "Server-only transactional replay-protection record for Mux webhooks.",
      "type": "object",
      "properties": {
        "eventId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "maxLength": 100 },
        "assetId": { "type": "string", "maxLength": 128 },
        "processedAt": { "type": "string" }
      },
      "required": ["eventId", "type"]
    },
    "MigrationCheckpoint": {
      "title": "MigrationCheckpoint",
      "description": "Admin-only resumable cursor checkpoint for background data migrations.",
      "type": "object",
      "properties": {
        "jobId": { "type": "string", "maxLength": 128 },
        "lastDocId": { "type": "string", "maxLength": 128 },
        "completed": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["jobId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Public and member profiles of Arvdoul users"
    },
    "/active_days/{userId}/days/{dayId}": {
      "schema": "ActiveDayLedger",
      "description": "Server-authoritative daily activity ledger"
    },
    "/achievements/{userId}/items/{achievementId}": {
      "schema": "Achievement",
      "description": "User earned achievements and milestones"
    },
    "/titles/{userId}/items/{titleId}": {
      "schema": "Title",
      "description": "User recognized titles and honours"
    },
    "/creator_profiles/{userId}": {
      "schema": "CreatorProfile",
      "description": "Creator capability metadata and status"
    },
    "/reputation/{userId}": {
      "schema": "UserReputation",
      "description": "User trust, integrity, and reputation standing"
    },
    "/posts/{postId}": {
      "schema": "Post",
      "description": "Multi-format social posts and video reels"
    },
    "/spaces/{spaceId}": {
      "schema": "Space",
      "description": "Live interactive audio lounges"
    },
    "/marketplace_items/{itemId}": {
      "schema": "MarketplaceItem",
      "description": "Digital assets and creator storefront items"
    },
    "/polls/{pollId}": {
      "schema": "Poll",
      "description": "Community votes and prediction markets"
    },
    "/creator_verifications/{verificationId}": {
      "schema": "CreatorVerification",
      "description": "Creator verification application records"
    },
    "/payout_requests/{requestId}": {
      "schema": "PayoutRequest",
      "description": "Creator payout withdrawal queue records"
    },
    "/support_tickets/{ticketId}": {
      "schema": "SupportTicket",
      "description": "Support tickets and automated triage resolutions"
    },
    "/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "Immutable security and administrative audit trail"
    },
    "/profile_analytics/{userId}": {
      "schema": "ProfileAnalytics",
      "description": "User profile metrics, daily stats, and reach aggregations"
    },
    "/counter_shards/{shardId}": {
      "schema": "CounterShard",
      "description": "Distributed counter shards for high-frequency writes"
    },
